# Source and local development state.
.git/**
.gitignore
.vscodeignore
.github/**
.vscode/**
.agents/**
.claude/**
src/**
scripts/**
dist/**
docs/**
additional/**
memory/**
.co/**
.vscode-test/**

# Build/test configuration and local release artifacts.
tsconfig.json
tsconfig.test.json
vitest.config.ts
package-lock.json
*.vsix
coverage/**
fuse.log
isim.log

# Development documentation that is not part of the shipped extension.
AGENTS.md
ARCHITECTURE_REVIEW.md
CLAUDE.md
CO_SUBSET_SYNTAX_COVERAGE_PLAN.md

# Generated debug/test output.
**/*.map
**/*.test.*
out/test/**

# Stale compiled files from previous source layouts.
out/projectConfig.js
out/projectWizard.js
out/courseTesting/logisimRunner.js
out/courseTesting/p7Testbench.js
out/language/logisim/folding.js
out/language/verilog/analysis.js
out/language/verilog/instanceParser.js
out/language/verilog/lintAlwaysRules.js
out/language/verilog/lintDeclarationRules.js
out/language/verilog/lintInstantiationRules.js
out/language/verilog/lintMagicNumberRules.js
out/language/verilog/lintNamingRules.js
out/language/verilog/lintSignalNames.js
out/language/verilog/lintTestbenchRules.js
out/language/verilog/lintUtils.js
out/language/verilog/statementValidator.js
out/language/verilog/syntaxAssignmentValidation.js
out/language/verilog/syntaxDeclarationKeywords.js
out/language/verilog/syntaxDeclarationValidation.js
out/language/verilog/syntaxExpressionValidation.js
out/language/verilog/syntaxInstanceValidation.js
out/language/verilog/syntaxModuleHeaderValidation.js
out/language/verilog/syntaxParserUtils.js
out/language/verilog/syntaxProceduralValidation.js
out/language/verilog/tokenNavigation.js

# Runtime uses the compiled class only.
resources/mars/_co_internal_unknown_instruction.java

# ISA catalog is compiled into out/mips/core/generated/isaCatalog.js; the JSON
# is a build input only.
resources/mips/isa.json

# Conformance harness and pinned-reference cache are development artifacts.
conformance/**

# Dependency files that are useful for development but not runtime.
node_modules/**/*.d.ts
node_modules/**/*.map
node_modules/**/README*
node_modules/**/CHANGELOG*
node_modules/**/changelog*
node_modules/**/SECURITY*
node_modules/**/.github/**
node_modules/**/test/**
node_modules/**/tests/**
