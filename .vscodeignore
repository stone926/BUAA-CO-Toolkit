# Keep the VSIX to bundled runtime code, assets, and notices.
# VSCE already excludes .git, .vscodeignore, package-lock.json, and *.vsix.

# Source, tests, CI, and local workspace state.
.gitignore
.github/**
.vscode/**
.agents/**
.claude/**
additional/**
conformance/**
coverage/**
dist/**
docs/**
memory/**
.co/**
scripts/**
src/**
test-cli/**
tmp/**

# Development-only configuration and local instruction files.
tsconfig.json
tsconfig.test.json
tsconfig.webview.json
.perf-findings.json
vitest.config.ts
AGENTS.md
CLAUDE.md
_CLAUDE.md
fuse.log
isim.log

# Generated source inputs with a compiled runtime equivalent.
resources/mars/_co_internal_unknown_instruction.java
resources/mips/isa.json

# Ship only self-contained entry points; per-file tsc output is for local verification.
out/**
!out/extension.js
!out/server.js
!out/mips/host/workerMain.js
!out/mips/cli/main.js
!out/moduleUtils.js
!out/traceParser.js
!out/iverilogRuntime.js
!out/media/**
!out/THIRD_PARTY_NOTICES.md
**/*.map
**/*.test.*
out/test/**

# Source-control metadata nested in bundled third-party runtime directories.
**/.gitattributes
**/.gitignore

# Dependency licenses are preserved in out/THIRD_PARTY_NOTICES.md.
node_modules/**
