# Keep the VSIX to runtime code, assets, production dependencies, and notices.
# VSCE already excludes .git, .vscodeignore, package-lock.json, and *.vsix.

# Source, tests, CI, and local workspace state.
.gitignore
.github/**
.vscode/**
.agents/**
.claude/**
additional/**
conformance/**
coverage/**
dist/**
docs/**
memory/**
.co/**
scripts/**
src/**
test-cli/**
tmp/**

# Development-only configuration and local instruction files.
tsconfig.json
tsconfig.test.json
vitest.config.ts
AGENTS.md
CLAUDE.md
_CLAUDE.md
fuse.log
isim.log

# Generated source inputs with a compiled runtime equivalent.
resources/mars/_co_internal_unknown_instruction.java
resources/mips/isa.json

# Test and source-map output. vscode:prepublish cleans out/ before compilation,
# so no per-file stale-output denylist is needed here.
**/*.map
**/*.test.*
out/test/**

# Source-control metadata nested in bundled third-party runtime directories.
**/.gitattributes
**/.gitignore

# Dependency files useful for development but unnecessary at runtime. Keep
# license files and third-party notices in the package.
node_modules/**/*.d.ts
node_modules/**/*.map
node_modules/**/README*
node_modules/**/CHANGELOG*
node_modules/**/changelog*
node_modules/**/SECURITY*
node_modules/**/.github/**
node_modules/**/test/**
node_modules/**/tests/**
node_modules/@rolldown/**
