  "scripts": {
    "compile": "npm run sync:generated && npm run clean:compile && tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "package:vsix": "npm run sync:generated && vsce package --target win32-x64",
    "publish": "node scripts/release.mjs",
    "generate:manifest-config": "node scripts/generate-manifest-config.mjs",
    "check:manifest-config": "node scripts/generate-manifest-config.mjs --check",
    "sync:manifest-config": "npm run generate:manifest-config && npm run check:manifest-config",
    "generate:syntaxes": "node scripts/generate-syntaxes.mjs",
    "check:syntaxes": "node scripts/generate-syntaxes.mjs --check",
    "sync:syntaxes": "npm run generate:syntaxes && npm run check:syntaxes",
    "sync:generated": "npm run sync:manifest-config && npm run sync:syntaxes && npm run sync:isa-catalog",
    "check:generated": "npm run check:manifest-config && npm run check:syntaxes && npm run check:isa-catalog",
    "verify:generated-tree-clean": "node scripts/verify-generated-tree-clean.mjs",
    "clean:compile": "node scripts/clean-compile-output.mjs",
    "generate:diagnostic-catalog": "node scripts/generate-diagnostic-catalog.mjs",
    "check:diagnostic-catalog": "node scripts/generate-diagnostic-catalog.mjs --check",
    "test": "npm run sync:generated && vitest run",
    "test:coverage": "npm run sync:generated && vitest run --coverage",
    "test:all": "npm run compile && npm test && npm run test:coverage && node scripts/check-index.mjs",
    "generate:isa-catalog": "node scripts/generate-mips-isa.mjs",
    "check:isa-catalog": "node scripts/generate-mips-isa.mjs --check",
    "sync:isa-catalog": "npm run generate:isa-catalog && npm run check:isa-catalog",
    "mips:cli": "node out/mips/cli/main.js",
    "verify:mips-cli": "node scripts/verify-mips-cli.mjs",
    "verify:mips-worker": "node scripts/verify-mips-worker.mjs",
    "verify:process-supervisor": "node scripts/verify-process-supervisor.mjs",
    "verify:bundled-iverilog": "npm run compile && node scripts/verify-bundled-iverilog.mjs .",
    "verify:phase4": "npm run compile && node scripts/check-module-boundaries.mjs && node scripts/verify-mips-worker.mjs && node --test scripts/verify-real-cpu-shadow.test.mjs && vitest run src/test/courseTesting/builtinExecutionProvider.test.ts src/test/courseTesting/oracleDifferential.test.ts src/test/courseTesting/executorShadowRunner.test.ts src/test/courseTesting/executionAssertions.test.ts src/test/mipsReplay/builtinExecutionAdapter.test.ts src/test/mipsProviders/phase4ProviderResolver.test.ts src/test/courseTesting/traceRunner.test.ts src/test/courseTestLogisim.test.ts src/test/courseTestLogisimSignal.test.ts src/test/mipsCli/executeProtocol.test.ts src/test/mipsHost/workerExecutionJobs.test.ts src/test/courseTesting/batchRunner.test.ts src/test/courseTesting/courseTracePipeline.test.ts",
    "verify:phase4-real-cpu": "npm run compile && node --test scripts/verify-real-cpu-shadow.test.mjs && node scripts/verify-real-cpu-shadow.mjs",
    "verify:phase5": "npm run compile && node scripts/check-module-boundaries.mjs && node scripts/verify-mips-worker.mjs && vitest run src/test/mipsCore/assemblerCourse.test.ts src/test/mipsCore/assemblerFullStack.test.ts src/test/mipsCore/assemblerPseudoGolden.test.ts src/test/mipsProviders/builtinAssemblerProvider.test.ts src/test/mipsProviders/phase5ProviderResolver.test.ts src/test/mipsReplay/builtinExecutionAdapter.test.ts src/test/mipsReplay/builtinCaseExactReplay.test.ts src/test/mipsCli/protocol.test.ts src/test/mipsHost/workerJobs.test.ts",
    "verify:phase6:unit": "npm run compile && node scripts/check-module-boundaries.mjs && vitest run src/test/configProfile.test.ts src/test/courseConfig.test.ts src/test/toolchainPolicy.test.ts src/test/toolchainPolicyConsumers.test.ts src/test/mipsCore/assemblerArtifacts.test.ts src/test/mipsProviders/courseEnginePolicy.test.ts src/test/mipsProviders/providerResolver.test.ts src/test/mipsProviders/fixedMarsReference.test.ts src/test/courseTesting/fullStackShadowRunner.test.ts src/test/courseTesting/executorShadowRunner.test.ts src/test/courseTesting/traceRunner.test.ts src/test/courseTesting/machineCodeValidation.test.ts src/test/courseTesting/manifestCodec.test.ts src/test/courseTestLogisim.test.ts src/test/courseTestLogisimSignal.test.ts src/test/courseTestToolchain.test.ts src/test/courseTestContinuous.test.ts src/test/manifest.test.ts src/test/advancedToolModel.test.ts",
    "verify:phase6": "npm run verify:phase6:unit && npm --prefix conformance/mips run verify:phase6"
  },
