{
  "name": "buaa-co-toolkit",
  "displayName": "BUAA CO Toolkit",
  "description": "计算机组成实验 VSCode 工具箱：支持 Logisim、MARS MIPS 汇编和 Verilog",
  "version": "1.0.6",
  "publisher": "stone926",
  "icon": "icons/logo.png",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "mips",
    "verilog",
    "logisim",
    "mars",
    "co",
    "计算机组成"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension runs workspace projects with configured Java, MARS, ISE, Logisim, and other external toolchains."
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stone926/BUAA-CO-Toolkit.git"
  },
  "activationEvents": [
    "workspaceContains:**/*.circ"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coSidebarContainer",
          "title": "BUAA CO Toolkit",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "coSidebarContainer": [
        {
          "id": "coSidebar",
          "name": "计组工具箱",
          "icon": "$(circuit-board)",
          "contextualTitle": "BUAA CO Toolkit"
        },
        {
          "id": "coVerilogSignal",
          "name": "信号连线",
          "icon": "$(circuit-board)",
          "contextualTitle": "BUAA CO Toolkit",
          "when": "co.activeCoKind == verilog || co.verilogSignalVisible"
        }
      ]
    },
    "languages": [
      {
        "id": "mipsasm",
        "aliases": [
          "MIPS ASM",
          "mipsasm"
        ],
        "extensions": [
          ".asm",
          ".s",
          ".mips"
        ],
        "configuration": "./language-configuration/mipsasm.json"
      },
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ],
        "configuration": "./language-configuration/verilog.json"
      },
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog"
        ],
        "extensions": [
          ".sv",
          ".svh"
        ],
        "configuration": "./language-configuration/verilog.json"
      }
    ],
    "grammars": [
      {
        "language": "mipsasm",
        "scopeName": "source.mips",
        "path": "./syntaxes/mips.tmLanguage.json"
      },
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "./syntaxes/verilog.tmLanguage.json"
      },
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog.co",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mipsasm",
        "path": "./snippets/mipsasm.json"
      },
      {
        "language": "verilog",
        "path": "./snippets/verilog.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "mipsInstruction",
        "superType": "function",
        "description": "统一 token 分类模式下的 MIPS 指令"
      },
      {
        "id": "mipsRealInstruction",
        "superType": "function",
        "description": "真实/伪指令分类模式下的 MIPS 真实指令"
      },
      {
        "id": "mipsRInstruction",
        "superType": "function",
        "description": "MIPS R 型指令"
      },
      {
        "id": "mipsIInstruction",
        "superType": "function",
        "description": "MIPS I 型指令"
      },
      {
        "id": "mipsJInstruction",
        "superType": "function",
        "description": "MIPS J 型指令"
      },
      {
        "id": "mipsSpecialInstruction",
        "superType": "function",
        "description": "MIPS 特殊指令，如 syscall、break、eret 或 CP0 移动"
      },
      {
        "id": "mipsPseudoInstruction",
        "superType": "function",
        "description": "MIPS 伪指令或汇编器惯用法"
      },
      {
        "id": "mipsRegister",
        "superType": "variable",
        "description": "MIPS 寄存器，如 $t0、$s0 或 $zero"
      },
      {
        "id": "mipsCp0Register",
        "superType": "variable",
        "description": "MIPS CP0 寄存器，如 $12 Status、$13 Cause 或 $14 EPC"
      },
      {
        "id": "mipsMacro",
        "superType": "macro",
        "description": "MIPS 汇编器宏定义或宏调用"
      },
      {
        "id": "mipsMacroParameter",
        "superType": "parameter",
        "description": "MIPS 宏参数，如 %i"
      },
      {
        "id": "mipsLabel",
        "superType": "variable",
        "description": "MIPS 文本标签定义或引用"
      },
      {
        "id": "mipsDataSymbol",
        "superType": "variable",
        "description": "MIPS 数据段符号"
      },
      {
        "id": "mipsEqvSymbol",
        "superType": "variable",
        "description": "MIPS .eqv 符号"
      },
      {
        "id": "verilogModule",
        "superType": "class",
        "description": "Verilog 模块声明和模块类型引用"
      },
      {
        "id": "verilogPort",
        "superType": "property",
        "description": "Verilog 端口和命名端口连接"
      },
      {
        "id": "verilogSignal",
        "superType": "variable",
        "description": "Verilog 网线、寄存器、逻辑信号、整数和 genvar"
      },
      {
        "id": "verilogParameter",
        "superType": "parameter",
        "description": "Verilog 参数和局部参数"
      },
      {
        "id": "verilogInstance",
        "superType": "variable",
        "description": "Verilog 模块实例名称"
      },
      {
        "id": "verilogMacro",
        "superType": "macro",
        "description": "Verilog 预处理器宏"
      },
      {
        "id": "verilogTask",
        "superType": "function",
        "description": "Verilog task 声明和调用"
      },
      {
        "id": "verilogFunction",
        "superType": "function",
        "description": "Verilog function 声明和调用"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "mipsInstruction": [
            "keyword.control.instruction.mips",
            "entity.name.function.mips",
            "keyword.control"
          ],
          "mipsRealInstruction": [
            "keyword.control.instruction.real.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsRInstruction": [
            "keyword.control.instruction.r-type.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsIInstruction": [
            "keyword.control.instruction.i-type.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsJInstruction": [
            "keyword.control.instruction.j-type.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsSpecialInstruction": [
            "keyword.control.instruction.special.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsPseudoInstruction": [
            "keyword.control.instruction.pseudo.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsRegister": [
            "variable.language.register.mips",
            "variable.language"
          ],
          "mipsCp0Register": [
            "variable.language.register.cp0.mips",
            "variable.language.register.mips",
            "variable.language"
          ],
          "mipsMacro": [
            "entity.name.function.macro.mips",
            "entity.name.function.preprocessor"
          ],
          "mipsMacroParameter": [
            "variable.parameter.macro.mips",
            "variable.parameter"
          ],
          "mipsLabel": [
            "entity.name.label.mips",
            "entity.name.label"
          ],
          "mipsDataSymbol": [
            "variable.other.data.mips",
            "variable.other"
          ],
          "mipsEqvSymbol": [
            "variable.other.constant.eqv.mips",
            "variable.other.constant",
            "constant.other"
          ],
          "verilogModule": [
            "entity.name.type.module.verilog",
            "entity.name.type.verilog",
            "entity.name.type.class"
          ],
          "verilogPort": [
            "variable.other.port.verilog",
            "variable.other.property.verilog",
            "variable.other.property"
          ],
          "verilogSignal": [
            "variable.other.signal.verilog",
            "variable.other.readwrite.verilog",
            "variable.other.readwrite"
          ],
          "verilogParameter": [
            "constant.other.parameter.verilog",
            "variable.other.constant.parameter.verilog",
            "variable.other.constant"
          ],
          "verilogInstance": [
            "variable.other.instance.verilog",
            "variable.other"
          ],
          "verilogMacro": [
            "entity.name.function.preprocessor.verilog",
            "entity.name.function.preprocessor"
          ],
          "verilogTask": [
            "entity.name.function.task.verilog",
            "entity.name.function"
          ],
          "verilogFunction": [
            "entity.name.function.verilog",
            "entity.name.function"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[mipsasm]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[verilog]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "commands": [
      {
        "command": "co.checkToolchain",
        "title": "CO: 检查工具链"
      },
      {
        "command": "co.selectProjectProfile",
        "title": "CO: 选择项目 Profile"
      },
      {
        "command": "co.sidebar.refresh",
        "title": "CO: 刷新侧边栏",
        "icon": "$(refresh)"
      },
      {
        "command": "co.projectWizard",
        "title": "CO: 项目向导",
        "icon": "$(new-folder)"
      },
      {
        "command": "co.tools.openAdvanced",
        "title": "CO: 更多工具",
        "icon": "$(tools)"
      },
      {
        "command": "co.mips.runCurrentFile",
        "title": "CO: MARS 运行当前文件"
      },
      {
        "command": "co.mips.runAndCapture",
        "title": "CO: MARS 运行并捕获输出"
      },
      {
        "command": "co.mips.runWithStdinFile",
        "title": "CO: MARS 带标准输入运行"
      },
      {
        "command": "co.mips.runInTerminal",
        "title": "CO: MARS 在终端中运行",
        "icon": {
          "light": "icons/run-terminal-light.svg",
          "dark": "icons/run-terminal-dark.svg"
        }
      },
      {
        "command": "co.mips.dumpText",
        "title": "CO: ASM 导出文本段",
        "icon": {
          "light": "icons/dump-text-light.svg",
          "dark": "icons/dump-text-dark.svg"
        }
      },
      {
        "command": "co.mips.dumpKernelText",
        "title": "CO: ASM 导出内核文本段"
      },
      {
        "command": "co.verilog.generateTestbench",
        "title": "CO: Verilog 生成 Testbench"
      },
      {
        "command": "co.verilog.generateIseProject",
        "title": "CO: Verilog 生成 ISE 工程",
        "enablement": "co.iseConfigured"
      },
      {
        "command": "co.verilog.checkSyntaxWithIse",
        "title": "CO: Verilog 检查语法",
        "icon": "$(checklist)"
      },
      {
        "command": "co.verilog.runIsim",
        "title": "CO: Verilog 运行仿真",
        "icon": {
          "light": "icons/run-isim-light.svg",
          "dark": "icons/run-isim-dark.svg"
        }
      },
      {
        "command": "co.verilog.openIsimWaveform",
        "title": "CO: Verilog 查看 ISim 波形",
        "icon": "$(pulse)",
        "enablement": "co.iseConfigured"
      },
      {
        "command": "co.verilog.exportVcd",
        "title": "CO: Verilog 导出 VCD 波形",
        "icon": "$(save)",
        "enablement": "co.iseConfigured"
      },
      {
        "command": "co.verilog.inspectSignal",
        "title": "CO: 查看 Verilog 信号连线",
        "icon": "$(circuit-board)"
      },
      {
        "command": "co.logisim.generateRom",
        "title": "CO: Logisim 生成 ROM 文件"
      },
      {
        "command": "co.logisim.injectRomIntoCircuit",
        "title": "CO: Logisim 注入 ROM 到电路"
      },
      {
        "command": "co.logisim.convertLogToCsv",
        "title": "CO: Logisim 日志转 CSV"
      },
      {
        "command": "co.logisim.openCurrentCircuit",
        "title": "CO: Logisim 打开当前电路",
        "icon": {
          "light": "icons/open-circuit-light.svg",
          "dark": "icons/open-circuit-dark.svg"
        }
      },
      {
        "command": "co.hazard.analyzeCurrentMachineCode",
        "title": "CO: 分析流水线冲突"
      },
      {
        "command": "co.hazard.openReport",
        "title": "CO: 打开冲突报告"
      },
      {
        "command": "co.test.startContinuousGeneratedTraceTests",
        "title": "CO: 启动持续测试"
      },
      {
        "command": "co.test.stopContinuousTests",
        "title": "CO: 停止持续测试"
      },
      {
        "command": "co.test.openAsmCaseIndex",
        "title": "CO: 测试历史 / 失败用例"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "co.sidebar.refresh",
          "when": "view == coSidebar",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "co.mips.runInTerminal",
          "when": "resourceLangId == mipsasm",
          "group": "navigation@10"
        },
        {
          "command": "co.mips.dumpText",
          "when": "resourceLangId == mipsasm",
          "group": "navigation@11"
        },
        {
          "command": "co.verilog.runIsim",
          "when": "(resourceLangId == verilog) && co.hasVerilogProfile",
          "group": "navigation@10"
        },
        {
          "command": "co.logisim.openCurrentCircuit",
          "when": "resourceExtname == .circ",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "co.logisim.injectRomIntoCircuit",
          "when": "resourceExtname == .circ || resourceLangId == mipsasm",
          "group": "co@10"
        },
        {
          "command": "co.verilog.generateTestbench",
          "when": "(resourceLangId == verilog) && co.hasVerilogProfile",
          "group": "co@10"
        },
        {
          "command": "co.verilog.checkSyntaxWithIse",
          "when": "(resourceLangId == verilog) && co.hasVerilogProfile",
          "group": "co@11"
        },
        {
          "command": "co.verilog.inspectSignal",
          "when": "(resourceLangId == verilog) && co.hasVerilogProfile",
          "group": "co@12"
        }
      ],
      "commandPalette": [
        {
          "command": "co.projectWizard"
        },
        {
          "command": "co.selectProjectProfile"
        },
        {
          "command": "co.checkToolchain"
        },
        {
          "command": "co.test.startContinuousGeneratedTraceTests"
        },
        {
          "command": "co.test.stopContinuousTests"
        },
        {
          "command": "co.test.openAsmCaseIndex"
        },
        {
          "command": "co.tools.openAdvanced"
        },
        {
          "command": "co.sidebar.refresh",
          "when": "false"
        },
        {
          "command": "co.mips.runCurrentFile",
          "when": "false"
        },
        {
          "command": "co.mips.runAndCapture",
          "when": "false"
        },
        {
          "command": "co.mips.runWithStdinFile",
          "when": "false"
        },
        {
          "command": "co.mips.runInTerminal",
          "when": "false"
        },
        {
          "command": "co.mips.dumpText",
          "when": "false"
        },
        {
          "command": "co.mips.dumpKernelText",
          "when": "false"
        },
        {
          "command": "co.verilog.generateTestbench",
          "when": "false"
        },
        {
          "command": "co.verilog.generateIseProject",
          "when": "false"
        },
        {
          "command": "co.verilog.checkSyntaxWithIse",
          "when": "false"
        },
        {
          "command": "co.verilog.runIsim",
          "when": "false"
        },
        {
          "command": "co.verilog.openIsimWaveform",
          "when": "false"
        },
        {
          "command": "co.verilog.exportVcd",
          "when": "false"
        },
        {
          "command": "co.verilog.inspectSignal",
          "when": "false"
        },
        {
          "command": "co.logisim.generateRom",
          "when": "false"
        },
        {
          "command": "co.logisim.injectRomIntoCircuit",
          "when": "false"
        },
        {
          "command": "co.logisim.convertLogToCsv",
          "when": "false"
        },
        {
          "command": "co.logisim.openCurrentCircuit",
          "when": "false"
        },
        {
          "command": "co.hazard.analyzeCurrentMachineCode",
          "when": "false"
        },
        {
          "command": "co.hazard.openReport",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "title": "课程项目",
        "order": 10,
        "properties": {
          "co.project.profile": {
            "type": "string",
            "enum": [
              "auto",
              "P0",
              "P1",
              "P2",
              "P3",
              "P4",
              "P5",
              "P6",
              "P7"
            ],
            "description": "当前项目 Profile。auto 会根据项目文件、Verilog 顶层接口和 trace 格式推断具体 P 并保存；无法推断时会要求手动选择并保存",
            "scope": "resource",
            "order": 10,
            "default": "auto",
            "enumDescriptions": [
              "根据当前工作区内容自动推断 Profile",
              "初识 Logisim",
              "初识 Verilog",
              "初识 ASM",
              "Logisim 单周期 CPU",
              "Verilog 单周期 CPU",
              "Verilog 五级流水线（阻塞+转发）",
              "流水线 + 乘除法 + 外置存储器",
              "MIPS 微系统（异常+外设）"
            ]
          },
          "co.test.instructions": {
            "type": "string",
            "description": "自动测试重点覆盖的真实指令。用逗号或空白分隔；留空时覆盖当前 Profile 的完整课程指令集。测试规模、中断、异常、外设和持续测试策略由插件自动使用最强安全配置。",
            "scope": "resource",
            "order": 20,
            "default": "",
            "markdownDescription": "自动测试重点覆盖的真实指令。测试脚手架所需指令由插件内部管理，不需要手工加入。\n\n- 用逗号或任意数量空白分隔。\n- 只接受真实指令，不接受伪指令。\n- 留空时使用当前 Profile 的默认指令集。\n\n各 Profile 默认指令集：\n- **P3**: `add, sub, ori, lw, sw, beq, lui, nop`\n- **P4**: `add, sub, ori, lw, sw, beq, lui, jal, jr, nop`\n- **P5**: `add, sub, ori, lw, sw, beq, lui, jal, jr, nop`\n- **P6**: `add, sub, and, or, slt, sltu, lui, addi, andi, ori, lb, lh, lw, sb, sh, sw, mult, multu, div, divu, mfhi, mflo, mthi, mtlo, beq, bne, jal, jr, nop`\n- **P7**: `add, sub, and, or, slt, sltu, lui, addi, andi, ori, lb, lh, lw, sb, sh, sw, mult, multu, div, divu, mfhi, mflo, mthi, mtlo, beq, bne, jal, jr, mfc0, mtc0, eret, syscall, nop`"
          }
        }
      },
      {
        "title": "外部工具",
        "order": 20,
        "properties": {
          "co.toolchain.java": {
            "type": "string",
            "description": "运行 MARS 和 Logisim 使用的 Java 命令。通常保持为 java",
            "scope": "machine-overridable",
            "order": 10,
            "default": "java"
          },
          "co.toolchain.python": {
            "type": "string",
            "description": "运行流水线冲突分析使用的 Python 命令。留空时自动检测",
            "scope": "machine-overridable",
            "order": 20,
            "default": ""
          },
          "co.toolchain.mars": {
            "type": "string",
            "description": "P2 汇编和运行使用的 Mars jar 路径。P3-P7 自动测试使用内置参考引擎，无需配置",
            "scope": "machine-overridable",
            "order": 30,
            "default": ""
          },
          "co.toolchain.logisim": {
            "type": "string",
            "description": "P0 和 P3 使用的 Logisim jar 路径",
            "scope": "machine-overridable",
            "order": 40,
            "default": ""
          },
          "co.toolchain.isePath": {
            "type": "string",
            "description": "Xilinx ISE 安装路径，例如 C:/Xilinx/14.7/ISE_DS/ISE。留空时使用扩展内置 Icarus；非空时显式选择 ISE，配置无效不会回退",
            "scope": "machine-overridable",
            "order": 50,
            "default": ""
          },
          "co.toolchain.hazardCalculator": {
            "type": "string",
            "description": "课程提供的 hazard_analysis 路径（含 Hazard-Calculator.jar 和 analyzer.py）",
            "scope": "machine-overridable",
            "order": 60,
            "default": ""
          }
        }
      },
      {
        "title": "编辑器体验",
        "order": 30,
        "properties": {
          "co.mips.warnPseudoInstruction": {
            "type": "boolean",
            "description": "当 ASM 使用 MIPS 伪指令时发出警告",
            "scope": "resource",
            "order": 10,
            "default": true
          },
          "co.mips.instructionTokenMode": {
