{
  "name": "buaa-co-toolkit",
  "displayName": "BUAA CO Toolkit",
  "description": "计算机组成实验 VSCode 工具箱：支持内置 MIPS 汇编、Icarus Verilog 与 Logisim",
  "version": "1.6.2",
  "publisher": "stone926",
  "icon": "icons/logo.png",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "mips",
    "verilog",
    "logisim",
    "mars",
    "co",
    "计算机组成"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension runs workspace projects with its bundled MIPS assembler/runtime and Icarus, plus optional Logisim tooling."
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stone926/BUAA-CO-Toolkit.git"
  },
  "activationEvents": [
    "workspaceContains:**/*.circ"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coSidebarContainer",
          "title": "BUAA CO Toolkit",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "coSidebarContainer": [
        {
          "id": "coSidebar",
          "name": "计组工具箱",
          "icon": "$(circuit-board)",
          "contextualTitle": "BUAA CO Toolkit"
        },
        {
          "id": "coVerilogSignal",
          "name": "信号连线",
          "icon": "$(circuit-board)",
          "contextualTitle": "BUAA CO Toolkit",
          "when": "co.activeCoKind == verilog || co.verilogSignalVisible"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "co.waveform.viewer",
        "displayName": "CO 波形查看器",
        "selector": [
          {
            "filenamePattern": "*.vcd"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "mipsasm",
        "aliases": [
          "MIPS ASM",
          "mipsasm"
        ],
        "extensions": [
          ".asm",
          ".s",
          ".mips"
        ],
        "configuration": "./language-configuration/mipsasm.json"
      },
      {
        "id": "mipsasm-instruction",
        "aliases": [
          "mipsasm-instruction"
        ],
        "extensions": []
      },
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh"
        ],
        "configuration": "./language-configuration/verilog.json"
      },
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog"
        ],
        "extensions": [
          ".sv",
          ".svh"
        ],
        "configuration": "./language-configuration/verilog.json"
      }
    ],
    "grammars": [
      {
        "language": "mipsasm",
        "scopeName": "source.mips",
        "path": "./syntaxes/mips.tmLanguage.json"
      },
      {
        "language": "mipsasm-instruction",
        "scopeName": "source.mips.instruction-preview",
        "path": "./syntaxes/mips-instruction-preview.tmLanguage.json"
      },
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "./syntaxes/verilog.tmLanguage.json"
      },
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog.co",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mipsasm",
        "path": "./snippets/mipsasm.json"
      },
      {
        "language": "verilog",
        "path": "./snippets/verilog.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "mipsInstruction",
        "superType": "function",
        "description": "统一 token 分类模式下的 MIPS 指令"
      },
      {
        "id": "mipsRealInstruction",
        "superType": "function",
        "description": "真实/伪指令分类模式下的 MIPS 真实指令"
      },
      {
        "id": "mipsRInstruction",
        "superType": "function",
        "description": "MIPS R 型指令"
      },
      {
        "id": "mipsIInstruction",
        "superType": "function",
        "description": "MIPS I 型指令"
      },
      {
        "id": "mipsJInstruction",
        "superType": "function",
        "description": "MIPS J 型指令"
      },
      {
        "id": "mipsSpecialInstruction",
        "superType": "function",
        "description": "MIPS 特殊指令，如 syscall、break、eret 或 CP0 移动"
      },
      {
        "id": "mipsPseudoInstruction",
        "superType": "function",
        "description": "MIPS 伪指令或汇编器惯用法"
      },
      {
        "id": "mipsRegister",
        "superType": "variable",
        "description": "MIPS 寄存器，如 $t0、$s0 或 $zero"
      },
      {
        "id": "mipsCp0Register",
        "superType": "variable",
        "description": "MIPS CP0 寄存器，如 $12 Status、$13 Cause 或 $14 EPC"
      },
      {
        "id": "mipsMacro",
        "superType": "macro",
        "description": "MIPS 汇编器宏定义或宏调用"
      },
      {
        "id": "mipsMacroParameter",
        "superType": "parameter",
        "description": "MIPS 宏参数，如 %i"
      },
      {
        "id": "mipsLabel",
        "superType": "variable",
        "description": "MIPS 文本标签定义或引用"
      },
      {
        "id": "mipsDataSymbol",
        "superType": "variable",
        "description": "MIPS 数据段符号"
      },
      {
        "id": "mipsEqvSymbol",
        "superType": "variable",
        "description": "MIPS .eqv 符号"
      },
      {
        "id": "verilogModule",
        "superType": "class",
        "description": "Verilog 模块声明和模块类型引用"
      },
      {
        "id": "verilogPort",
        "superType": "property",
        "description": "Verilog 端口和命名端口连接"
      },
      {
        "id": "verilogSignal",
        "superType": "variable",
        "description": "Verilog 网线、寄存器、逻辑信号、整数和 genvar"
      },
      {
        "id": "verilogParameter",
        "superType": "parameter",
        "description": "Verilog 参数和局部参数"
      },
      {
        "id": "verilogInstance",
        "superType": "variable",
        "description": "Verilog 模块实例名称"
      },
      {
        "id": "verilogMacro",
        "superType": "macro",
        "description": "Verilog 预处理器宏"
      },
      {
        "id": "verilogTask",
        "superType": "function",
        "description": "Verilog task 声明和调用"
      },
      {
        "id": "verilogFunction",
        "superType": "function",
        "description": "Verilog function 声明和调用"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "mipsInstruction": [
            "keyword.control.instruction.mips",
            "entity.name.function.mips",
            "keyword.control"
          ],
          "mipsRealInstruction": [
            "keyword.control.instruction.real.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsRInstruction": [
            "keyword.control.instruction.r-type.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsIInstruction": [
            "keyword.control.instruction.i-type.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsJInstruction": [
            "keyword.control.instruction.j-type.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsSpecialInstruction": [
            "keyword.control.instruction.special.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsPseudoInstruction": [
            "keyword.control.instruction.pseudo.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsRegister": [
            "variable.language.register.mips",
            "variable.language"
          ],
          "mipsCp0Register": [
            "variable.language.register.cp0.mips",
            "variable.language.register.mips",
            "variable.language"
          ],
          "mipsMacro": [
            "entity.name.function.macro.mips",
            "entity.name.function.preprocessor"
          ],
          "mipsMacroParameter": [
            "variable.parameter.macro.mips",
            "variable.parameter"
          ],
          "mipsLabel": [
            "entity.name.label.mips",
            "entity.name.label"
          ],
          "mipsDataSymbol": [
            "variable.other.data.mips",
            "variable.other"
          ],
          "mipsEqvSymbol": [
            "variable.other.constant.eqv.mips",
            "variable.other.constant",
            "constant.other"
          ],
          "verilogModule": [
            "entity.name.type.module.verilog",
            "entity.name.type.verilog",
            "entity.name.type.class"
          ],
          "verilogPort": [
            "variable.other.port.verilog",
            "variable.other.property.verilog",
            "variable.other.property"
          ],
          "verilogSignal": [
            "variable.other.signal.verilog",
            "variable.other.readwrite.verilog",
            "variable.other.readwrite"
          ],
          "verilogParameter": [
            "constant.other.parameter.verilog",
            "variable.other.constant.parameter.verilog",
            "variable.other.constant"
          ],
          "verilogInstance": [
            "variable.other.instance.verilog",
            "variable.other"
          ],
          "verilogMacro": [
            "entity.name.function.preprocessor.verilog",
            "entity.name.function.preprocessor"
          ],
          "verilogTask": [
            "entity.name.function.task.verilog",
            "entity.name.function"
          ],
          "verilogFunction": [
            "entity.name.function.verilog",
            "entity.name.function"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[mipsasm]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[verilog]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "commands": [
      {
        "command": "co.mips.createCustomInstruction",
        "title": "CO: 创建 JS/TS 自定义指令"
      },
      {
        "command": "co.checkToolchain",
        "title": "CO: 检查工具链"
      },
      {
        "command": "co.selectProjectProfile",
        "title": "CO: 选择项目 Profile"
      },
      {
        "command": "co.sidebar.refresh",
        "title": "CO: 刷新侧边栏",
        "icon": "$(refresh)"
      },
      {
        "command": "co.projectWizard",
        "title": "CO: 项目向导",
        "icon": "$(new-folder)"
      },
      {
        "command": "co.tools.openAdvanced",
        "title": "CO: 更多工具",
        "icon": "$(tools)"
      },
      {
        "command": "co.mips.openWorkbench",
        "title": "CO: 打开 MARS 调试工作台",
        "icon": "$(debug-alt)"
      },
      {
        "command": "co.mips.runCurrentFile",
        "title": "CO: 运行当前 ASM 文件"
      },
      {
        "command": "co.mips.runWithStdinFile",
        "title": "CO: ASM 带标准输入运行"
      },
      {
        "command": "co.mips.runInTerminal",
        "title": "CO: ASM 在终端中运行",
        "icon": "$(terminal)"
      },
      {
        "command": "co.mips.dumpText",
        "title": "CO: ASM 导出文本段",
        "icon": "$(export)"
      },
      {
        "command": "co.mips.dumpKernelText",
        "title": "CO: ASM 导出内核文本段"
      },
      {
        "command": "co.verilog.configureProjects",
        "title": "CO: Verilog 自动分析并配置独立工程"
      },
      {
        "command": "co.verilog.generateTestbench",
        "title": "CO: Verilog 生成 Testbench"
      },
      {
        "command": "co.verilog.checkSyntax",
        "title": "CO: Verilog 检查语法",
        "icon": "$(checklist)"
      },
      {
        "command": "co.verilog.runSimulation",
        "title": "CO: Verilog 运行仿真",
        "icon": "$(play)"
      },
      {
        "command": "co.verilog.viewWaveform",
        "title": "CO: Verilog 仿真并查看波形",
        "icon": "$(pulse)"
      },
      {
        "command": "co.waveform.openFile",
        "title": "CO: 用波形查看器打开 VCD",
        "icon": "$(graph-line)"
      },
      {
        "command": "co.waveform.goToTime",
        "title": "CO: 波形跳转到时间或周期"
      },
      {
        "command": "co.waveform.showHelp",
        "title": "CO: 波形查看器快捷键帮助"
      },
      {
        "command": "co.waveform.selectAllRows",
        "title": "CO: 波形全选信号行"
      },
      {
        "command": "co.verilog.inspectSignal",
        "title": "CO: 查看 Verilog 信号连线",
        "icon": "$(circuit-board)"
      },
      {
        "command": "co.logisim.generateRom",
        "title": "CO: Logisim 生成 ROM 文件"
      },
      {
        "command": "co.logisim.injectRomIntoCircuit",
        "title": "CO: Logisim 注入 ROM 到电路"
      },
      {
        "command": "co.logisim.convertLogToCsv",
        "title": "CO: Logisim 日志转 CSV"
      },
      {
        "command": "co.logisim.openCurrentCircuit",
        "title": "CO: Logisim 打开当前电路",
        "icon": "$(circuit-board)"
      },
      {
        "command": "co.hazard.analyzeCurrentMachineCode",
        "title": "CO: 分析流水线冲突"
      },
      {
        "command": "co.hazard.openReport",
        "title": "CO: 打开冲突报告"
      },
      {
        "command": "co.test.runAsmTests",
        "title": "CO: 测试用户汇编文件 / 目录",
        "icon": "$(beaker)"
      },
      {
        "command": "co.test.startContinuousGeneratedTraceTests",
        "title": "CO: 启动持续测试",
        "icon": "$(rocket)"
      },
      {
        "command": "co.test.stopContinuousTests",
        "title": "CO: 停止持续测试",
        "icon": "$(debug-stop)"
      },
      {
        "command": "co.test.openAsmCaseIndex",
        "title": "CO: 测试历史 / 失败用例"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "co.sidebar.refresh",
          "when": "view == coSidebar",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "co.mips.openWorkbench",
          "when": "resourceLangId == mipsasm",
          "group": "navigation@0"
        },
        {
          "command": "co.mips.runInTerminal",
          "when": "resourceLangId == mipsasm",
          "group": "navigation@10"
        },
        {
          "command": "co.mips.dumpText",
          "when": "resourceLangId == mipsasm",
          "group": "navigation@11"
        },
        {
          "command": "co.verilog.runSimulation",
          "when": "(resourceLangId == verilog) && co.hasVerilogProfile",
          "group": "navigation@10"
        },
        {
          "command": "co.verilog.viewWaveform",
          "when": "(resourceLangId == verilog) && co.hasVerilogProfile",
          "group": "navigation@11"
        },
        {
          "command": "co.test.startContinuousGeneratedTraceTests",
          "when": "co.hasTraceProfile && !co.continuousTestRunning",
          "group": "navigation@12"
        },
        {
          "command": "co.test.stopContinuousTests",
          "when": "co.continuousTestRunning",
          "group": "navigation@12"
        },
        {
          "command": "co.logisim.openCurrentCircuit",
          "when": "resourceExtname == .circ",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "co.test.runAsmTests",
          "when": "resourceLangId == mipsasm",
          "group": "co@9"
        },
        {
          "command": "co.logisim.injectRomIntoCircuit",
          "when": "resourceExtname == .circ || resourceLangId == mipsasm",
          "group": "co@10"
        },
        {
          "command": "co.verilog.generateTestbench",
          "when": "(resourceLangId == verilog) && co.hasVerilogProfile",
          "group": "co@10"
        },
        {
          "command": "co.verilog.viewWaveform",
          "when": "(resourceLangId == verilog) && co.hasVerilogProfile",
          "group": "co@10"
        },
        {
          "command": "co.verilog.checkSyntax",
          "when": "(resourceLangId == verilog) && co.hasVerilogProfile",
          "group": "co@11"
        },
        {
          "command": "co.verilog.inspectSignal",
          "when": "(resourceLangId == verilog) && co.hasVerilogProfile",
          "group": "co@12"
        }
      ],
      "explorer/context": [
        {
          "command": "co.waveform.openFile",
          "when": "resourceExtname == .vcd",
          "group": "navigation@20"
        }
      ],
      "commandPalette": [
        {
          "command": "co.mips.createCustomInstruction"
        },
        {
          "command": "co.test.runAsmTests"
        },
        {
          "command": "co.mips.openWorkbench",
          "when": "resourceLangId == mipsasm"
        },
        {
          "command": "co.projectWizard"
        },
        {
          "command": "co.selectProjectProfile"
        },
        {
          "command": "co.checkToolchain"
        },
        {
          "command": "co.test.startContinuousGeneratedTraceTests"
        },
        {
          "command": "co.test.stopContinuousTests"
        },
        {
          "command": "co.test.openAsmCaseIndex"
        },
        {
          "command": "co.tools.openAdvanced"
        },
        {
          "command": "co.sidebar.refresh",
          "when": "false"
        },
        {
          "command": "co.mips.runCurrentFile",
          "when": "false"
        },
        {
          "command": "co.mips.runWithStdinFile",
          "when": "false"
        },
        {
          "command": "co.mips.runInTerminal",
          "when": "false"
        },
        {
          "command": "co.mips.dumpText",
          "when": "false"
        },
        {
          "command": "co.mips.dumpKernelText",
          "when": "false"
        },
        {
          "command": "co.verilog.configureProjects",
          "when": "false"
        },
        {
          "command": "co.verilog.generateTestbench",
          "when": "false"
        },
        {
          "command": "co.verilog.checkSyntax",
          "when": "false"
        },
        {
          "command": "co.verilog.runSimulation",
          "when": "false"
        },
        {
          "command": "co.verilog.viewWaveform",
          "when": "false"
        },
        {
          "command": "co.waveform.openFile",
          "when": "false"
        },
        {
          "command": "co.waveform.goToTime",
          "when": "false"
        },
        {
          "command": "co.waveform.showHelp",
          "when": "false"
        },
        {
          "command": "co.waveform.selectAllRows",
          "when": "false"
        },
        {
          "command": "co.verilog.inspectSignal",
          "when": "false"
        },
        {
          "command": "co.logisim.generateRom",
          "when": "false"
        },
        {
          "command": "co.logisim.injectRomIntoCircuit",
          "when": "false"
        },
        {
          "command": "co.logisim.convertLogToCsv",
          "when": "false"
        },
        {
          "command": "co.logisim.openCurrentCircuit",
          "when": "false"
        },
        {
          "command": "co.hazard.analyzeCurrentMachineCode",
          "when": "co.profile == P5 || co.profile == P6 || co.profile == P7"
        },
        {
          "command": "co.hazard.openReport"
        }
      ]
    },
    "keybindings": [
      {
        "command": "co.waveform.goToTime",
        "key": "ctrl+g",
        "mac": "cmd+g",
        "when": "activeCustomEditorId == 'co.waveform.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus"
      },
      {
        "command": "co.waveform.showHelp",
        "key": "f1",
        "when": "activeCustomEditorId == 'co.waveform.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus"
      },
      {
        "command": "co.waveform.selectAllRows",
        "key": "ctrl+a",
        "mac": "cmd+a",
        "when": "activeCustomEditorId == 'co.waveform.viewer' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus"
      }
    ],
    "configuration": [
      {
        "title": "课程项目",
        "order": 10,
        "properties": {
          "co.project.profile": {
            "type": "string",
            "description": "工作区默认 Profile。独立项目的 co.project.overrides 配置优先；多项目工作区中，可靠的项目推断也优先于此默认值。auto 不写入固定阶段。侧边栏的手动选择只修改当前项目。",
            "scope": "resource",
            "order": 10,
            "default": "auto",
            "enum": [
              "auto",
              "P0",
              "P1",
              "P2",
              "P3",
              "P4",
              "P5",
              "P6",
              "P7"
            ],
            "enumDescriptions": [
              "根据当前工作区内容自动推断 Profile",
              "初识 Logisim",
              "初识 Verilog",
              "初识 ASM",
              "Logisim 单周期 CPU",
              "Verilog 单周期 CPU",
              "Verilog 五级流水线（阻塞+转发）",
              "流水线 + 乘除法 + 外置存储器",
              "MIPS 微系统（异常+外设）"
            ]
          },
          "co.project.overrides": {
            "type": "object",
            "description": "项目专属设置，键为相对工作区的项目目录或源文件路径，例如 {\"p4\":{\"profile\":\"P4\"},\"p5\":{\"profile\":\"P5\"}}。支持 profile、topModule、testbench、machineCode、simTime；共享依赖沿所属项目使用设置。工作区只是项目容器。",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "profile": {
                  "type": "string",
