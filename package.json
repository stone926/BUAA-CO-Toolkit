{
  "name": "buaa-co-toolkit",
  "displayName": "BUAA CO Toolkit",
  "description": "计算机组成实验 VSCode 工具箱：支持 Logisim、MARS MIPS 汇编和 Verilog",
  "version": "0.7.1",
  "publisher": "stone926",
  "icon": "icons/logo.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "mips",
    "verilog",
    "logisim",
    "mars",
    "co",
    "计算机组成"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/stone926/BUAA-CO-Toolkit.git"
  },
  "activationEvents": [
    "workspaceContains:**/*.circ"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coSidebarContainer",
          "title": "BUAA CO Toolkit",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "coSidebarContainer": [
        {
          "id": "coSidebar",
          "name": "计组工具箱",
          "icon": "$(circuit-board)",
          "contextualTitle": "BUAA CO Toolkit"
        },
        {
          "id": "coVerilogSignal",
          "name": "信号连线",
          "icon": "$(circuit-board)",
          "contextualTitle": "BUAA CO Toolkit",
          "when": "co.activeCoKind == verilog || co.verilogSignalVisible"
        }
      ]
    },
    "languages": [
      {
        "id": "mipsasm",
        "aliases": [
          "MIPS ASM",
          "mipsasm"
        ],
        "extensions": [
          ".asm",
          ".s",
          ".mips"
        ],
        "configuration": "./language-configuration/mipsasm.json"
      },
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v"
        ],
        "configuration": "./language-configuration/verilog.json"
      }
    ],
    "grammars": [
      {
        "language": "mipsasm",
        "scopeName": "source.mips",
        "path": "./syntaxes/mips.tmLanguage.json"
      },
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "./syntaxes/verilog.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mipsasm",
        "path": "./snippets/mipsasm.json"
      },
      {
        "language": "verilog",
        "path": "./snippets/verilog.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "mipsDirective",
        "superType": "keyword",
        "description": "MIPS 汇编器指令，如 .data、.text、.eqv 或 .macro"
      },
      {
        "id": "mipsInstruction",
        "superType": "function",
        "description": "单色模式下的 MIPS 指令"
      },
      {
        "id": "mipsRealInstruction",
        "superType": "function",
        "description": "真实/伪指令区分模式下的 MIPS 真实指令"
      },
      {
        "id": "mipsRInstruction",
        "superType": "function",
        "description": "MIPS R 型指令"
      },
      {
        "id": "mipsIInstruction",
        "superType": "function",
        "description": "MIPS I 型指令"
      },
      {
        "id": "mipsJInstruction",
        "superType": "function",
        "description": "MIPS J 型指令"
      },
      {
        "id": "mipsSpecialInstruction",
        "superType": "function",
        "description": "MIPS 特殊指令，如 syscall、break、eret 或 CP0 移动"
      },
      {
        "id": "mipsPseudoInstruction",
        "superType": "function",
        "description": "MIPS 伪指令或汇编器惯用法"
      },
      {
        "id": "mipsRegister",
        "superType": "variable",
        "description": "MIPS 寄存器，如 $t0、$s0 或 $zero"
      },
      {
        "id": "mipsCp0Register",
        "superType": "variable",
        "description": "MIPS CP0 寄存器，如 $12 Status、$13 Cause 或 $14 EPC"
      },
      {
        "id": "mipsMacro",
        "superType": "function",
        "description": "MIPS 汇编器宏定义或宏调用"
      },
      {
        "id": "mipsMacroParameter",
        "superType": "parameter",
        "description": "MIPS 宏参数，如 %i"
      },
      {
        "id": "mipsLabel",
        "superType": "variable",
        "description": "MIPS 文本标签定义或引用"
      },
      {
        "id": "mipsDataSymbol",
        "superType": "variable",
        "description": "MIPS 数据段符号"
      },
      {
        "id": "mipsEqvSymbol",
        "superType": "variable",
        "description": "MIPS .eqv 符号"
      },
      {
        "id": "mipsNumber",
        "superType": "number",
        "description": "MIPS 数值字面量"
      },
      {
        "id": "mipsString",
        "superType": "string",
        "description": "MIPS 字符串字面量"
      },
      {
        "id": "mipsComment",
        "superType": "comment",
        "description": "MIPS 行注释"
      },
      {
        "id": "mipsPunctuation",
        "superType": "operator",
        "description": "MIPS 标点符号，如逗号、冒号和括号"
      },
      {
        "id": "verilogModule",
        "superType": "class",
        "description": "Verilog 模块声明和模块类型引用"
      },
      {
        "id": "verilogPort",
        "superType": "property",
        "description": "Verilog 端口和命名端口连接"
      },
      {
        "id": "verilogSignal",
        "superType": "variable",
        "description": "Verilog 网线、寄存器、逻辑信号、整数和 genvar"
      },
      {
        "id": "verilogParameter",
        "superType": "enumMember",
        "description": "Verilog 参数和局部参数"
      },
      {
        "id": "verilogInstance",
        "superType": "variable",
        "description": "Verilog 模块实例名称"
      },
      {
        "id": "verilogMacro",
        "superType": "function",
        "description": "Verilog 预处理器宏"
      },
      {
        "id": "verilogSystemTask",
        "superType": "function",
        "description": "Verilog 系统任务，如 $display 和 $readmemh"
      },
      {
        "id": "verilogNumber",
        "superType": "number",
        "description": "Verilog 数值字面量"
      },
      {
        "id": "verilogKeyword",
        "superType": "keyword",
        "description": "Verilog 关键字"
      },
      {
        "id": "verilogComment",
        "superType": "comment",
        "description": "Verilog 注释"
      },
      {
        "id": "verilogString",
        "superType": "string",
        "description": "Verilog 字符串字面量"
      },
      {
        "id": "verilogFormatSpecifier",
        "superType": "regexp",
        "description": "Verilog 显示格式说明符，如 %d、%h 或 %0d"
      },
      {
        "id": "verilogPunctuation",
        "superType": "operator",
        "description": "Verilog 标点符号"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "mipsDirective": [
            "keyword.directive.mips",
            "keyword.control.directive",
            "keyword.other"
          ],
          "mipsInstruction": [
            "keyword.control.instruction.mips",
            "entity.name.function.mips",
            "keyword.control"
          ],
          "mipsRealInstruction": [
            "keyword.control.instruction.real.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsRInstruction": [
            "keyword.control.instruction.r-type.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsIInstruction": [
            "keyword.control.instruction.i-type.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsJInstruction": [
            "keyword.control.instruction.j-type.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsSpecialInstruction": [
            "keyword.control.instruction.special.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsPseudoInstruction": [
            "keyword.control.instruction.pseudo.mips",
            "keyword.control.instruction.mips",
            "keyword.control"
          ],
          "mipsRegister": [
            "variable.language.register.mips",
            "variable.language"
          ],
          "mipsCp0Register": [
            "variable.language.register.cp0.mips",
            "variable.language.register.mips",
            "variable.language"
          ],
          "mipsMacro": [
            "entity.name.function.macro.mips",
            "entity.name.function"
          ],
          "mipsMacroParameter": [
            "variable.parameter.macro.mips",
            "variable.parameter"
          ],
          "mipsLabel": [
            "entity.name.label.mips",
            "entity.name.label"
          ],
          "mipsDataSymbol": [
            "variable.other.data.mips",
            "variable.other"
          ],
          "mipsEqvSymbol": [
            "variable.other.constant.eqv.mips",
            "variable.other.constant",
            "constant.other"
          ],
          "mipsNumber": [
            "constant.numeric.mips",
            "constant.numeric"
          ],
          "mipsString": [
            "string.quoted.double.mips",
            "string.quoted.double"
          ],
          "mipsComment": [
            "comment.line.number-sign.mips",
            "comment.line",
            "comment"
          ],
          "mipsPunctuation": [
            "punctuation.separator.mips",
            "punctuation.definition.mips",
            "punctuation"
          ],
          "verilogModule": [
            "entity.name.type.module.verilog",
            "entity.name.type.verilog",
            "entity.name.type.class"
          ],
          "verilogPort": [
            "variable.other.port.verilog",
            "variable.other.property.verilog",
            "variable.other.property"
          ],
          "verilogSignal": [
            "variable.other.signal.verilog",
            "variable.other.readwrite.verilog",
            "variable.other.readwrite"
          ],
          "verilogParameter": [
            "constant.other.parameter.verilog",
            "variable.other.constant.parameter.verilog",
            "variable.other.constant"
          ],
          "verilogInstance": [
            "variable.other.instance.verilog",
            "variable.other"
          ],
          "verilogMacro": [
            "entity.name.function.preprocessor.verilog",
            "keyword.control.directive.verilog",
            "entity.name.function.preprocessor"
          ],
          "verilogSystemTask": [
            "support.function.system-task.verilog",
            "support.function"
          ],
          "verilogNumber": [
            "constant.numeric.verilog",
            "constant.numeric"
          ],
          "verilogKeyword": [
            "keyword.control.verilog",
            "keyword.control"
          ],
          "verilogComment": [
            "comment.line.double-slash.verilog",
            "comment.block.verilog",
            "comment"
          ],
          "verilogString": [
            "string.quoted.double.verilog",
            "string.quoted.double"
          ],
          "verilogFormatSpecifier": [
            "constant.other.placeholder.verilog",
            "constant.character.format.placeholder.verilog",
            "constant.other"
          ],
          "verilogPunctuation": [
            "punctuation.definition.verilog",
            "punctuation.separator.verilog",
            "punctuation"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[mipsasm]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[verilog]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "commands": [
      {
        "command": "co.checkToolchain",
        "title": "CO: 检查工具链"
      },
      {
        "command": "co.selectProjectProfile",
        "title": "CO: 选择项目 Profile"
      },
      {
        "command": "co.sidebar.refresh",
        "title": "CO: 刷新侧边栏",
        "icon": "$(refresh)"
      },
      {
        "command": "co.projectWizard",
        "title": "CO: 项目向导",
        "icon": "$(new-folder)"
      },
      {
        "command": "co.course.openTutorial",
        "title": "CO: 打开课程教程",
        "icon": "$(book)"
      },
      {
        "command": "co.tools.openAdvanced",
        "title": "CO: 更多工具",
        "icon": "$(tools)"
      },
      {
        "command": "co.course.openProfileTutorial",
        "title": "CO: 打开当前 Profile 教程",
        "icon": "$(symbol-class)"
      },
      {
        "command": "co.mips.runCurrentFile",
        "title": "CO: MARS 运行当前文件"
      },
      {
        "command": "co.mips.runAndCapture",
        "title": "CO: MARS 运行并捕获输出"
      },
      {
        "command": "co.mips.runWithStdinFile",
        "title": "CO: MARS 带标准输入运行"
      },
      {
        "command": "co.mips.runInTerminal",
        "title": "CO: MARS 在终端中运行",
        "icon": {
          "light": "icons/run-terminal-light.svg",
          "dark": "icons/run-terminal-dark.svg"
        }
      },
      {
        "command": "co.mips.dumpText",
        "title": "CO: ASM 导出文本段",
        "icon": {
          "light": "icons/dump-text-light.svg",
          "dark": "icons/dump-text-dark.svg"
        }
      },
      {
        "command": "co.mips.dumpKernelText",
        "title": "CO: ASM 导出内核文本段"
      },
      {
        "command": "co.verilog.generateTestbench",
        "title": "CO: Verilog 生成 Testbench"
      },
      {
        "command": "co.verilog.generateIseProject",
        "title": "CO: Verilog 生成 ISE 工程"
      },
      {
        "command": "co.verilog.checkSyntaxWithIse",
        "title": "CO: Verilog 使用 ISE 检查语法",
        "icon": "$(checklist)"
      },
      {
        "command": "co.verilog.runIsim",
        "title": "CO: Verilog 运行 ISim",
        "icon": {
          "light": "icons/run-isim-light.svg",
          "dark": "icons/run-isim-dark.svg"
        }
      },
      {
        "command": "co.verilog.openIsimWaveform",
        "title": "CO: Verilog 查看 ISim 波形",
        "icon": "$(pulse)"
      },
      {
        "command": "co.verilog.exportVcd",
        "title": "CO: Verilog 导出 VCD 波形",
        "icon": "$(save)"
      },
      {
        "command": "co.verilog.inspectSignal",
        "title": "CO: 查看 Verilog 信号连线",
        "icon": "$(circuit-board)"
      },
      {
        "command": "co.logisim.generateRom",
        "title": "CO: Logisim 生成 ROM 文件"
      },
      {
        "command": "co.logisim.injectRomIntoCircuit",
        "title": "CO: Logisim 注入 ROM 到电路"
      },
      {
        "command": "co.logisim.convertLogToCsv",
        "title": "CO: Logisim 日志转 CSV"
      },
      {
        "command": "co.logisim.openCurrentCircuit",
        "title": "CO: Logisim 打开当前电路",
        "icon": {
          "light": "icons/open-circuit-light.svg",
          "dark": "icons/open-circuit-dark.svg"
        }
      },
      {
        "command": "co.hazard.analyzeCurrentMachineCode",
        "title": "CO: 分析流水线冲突"
      },
      {
        "command": "co.hazard.openReport",
        "title": "CO: 打开冲突报告"
      },
      {
        "command": "co.test.compareTraceFiles",
        "title": "CO: 比较 Trace 输出文件"
      },
      {
        "command": "co.test.compareLatestOutputs",
        "title": "CO: 比较最近的 MARS/ISim 输出"
      },
      {
        "command": "co.test.runFullTest",
        "title": "CO: 运行完整课程 Trace 测试"
      },
      {
        "command": "co.test.runBatchTraceTests",
        "title": "CO: 运行批量课程 Trace 测试"
      },
      {
        "command": "co.test.runGeneratedTraceTests",
        "title": "CO: 运行生成的课程 Trace 测试"
      },
      {
        "command": "co.test.startContinuousGeneratedTraceTests",
        "title": "CO: 启动持续生成的课程 Trace 测试"
      },
      {
        "command": "co.test.generateAsmTests",
        "title": "CO: 生成 ASM 测试点"
      },
      {
        "command": "co.test.generateAndDumpAsmTests",
        "title": "CO: 生成并导出机器码测试点"
      },
      {
        "command": "co.test.stopContinuousTests",
        "title": "CO: 停止持续课程测试"
      },
      {
        "command": "co.test.prepareLogisimCases",
        "title": "CO: 准备 Logisim 电路用例"
      },
      {
        "command": "co.test.diagnoseP3LogisimTraceCircuit",
        "title": "CO: 诊断 P3 Logisim Trace 电路"
      },
      {
        "command": "co.test.prepareGeneratedLogisimCases",
        "title": "CO: 准备生成的 Logisim 电路用例"
      },
      {
        "command": "co.test.openBatchTraceReport",
        "title": "CO: 打开批量课程 Trace 报告"
      },
      {
        "command": "co.test.openAsmCaseIndex",
        "title": "CO: 查看 ASM 用例记录"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "co.sidebar.refresh",
          "when": "view == coSidebar",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "co.mips.runInTerminal",
          "when": "resourceLangId == mipsasm",
          "group": "navigation@10"
        },
        {
          "command": "co.mips.dumpText",
          "when": "resourceLangId == mipsasm",
          "group": "navigation@11"
        },
        {
          "command": "co.verilog.runIsim",
          "when": "(resourceLangId == verilog) && co.hasVerilogProfile",
          "group": "navigation@10"
        },
        {
          "command": "co.logisim.openCurrentCircuit",
          "when": "resourceExtname == .circ",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "co.logisim.injectRomIntoCircuit",
          "when": "resourceExtname == .circ || resourceLangId == mipsasm",
          "group": "co@10"
        },
        {
          "command": "co.verilog.generateTestbench",
          "when": "(resourceLangId == verilog) && co.hasVerilogProfile",
          "group": "co@10"
        },
        {
          "command": "co.verilog.checkSyntaxWithIse",
          "when": "(resourceLangId == verilog) && co.hasVerilogProfile",
          "group": "co@11"
        },
        {
          "command": "co.verilog.inspectSignal",
          "when": "(resourceLangId == verilog) && co.hasVerilogProfile",
          "group": "co@12"
        }
      ],
      "commandPalette": [
        {
          "command": "co.projectWizard"
        },
        {
          "command": "co.selectProjectProfile"
        },
        {
          "command": "co.checkToolchain"
        },
        {
          "command": "co.course.openTutorial"
        },
        {
          "command": "co.test.startContinuousGeneratedTraceTests"
        },
        {
          "command": "co.test.stopContinuousTests"
        },
        {
          "command": "co.test.openAsmCaseIndex"
        },
        {
          "command": "co.tools.openAdvanced"
        },
        {
          "command": "co.sidebar.refresh",
          "when": "false"
        },
        {
          "command": "co.course.openProfileTutorial",
          "when": "false"
        },
        {
          "command": "co.mips.runCurrentFile",
          "when": "false"
        },
        {
          "command": "co.mips.runAndCapture",
          "when": "false"
        },
        {
          "command": "co.mips.runWithStdinFile",
          "when": "false"
        },
        {
          "command": "co.mips.runInTerminal",
          "when": "false"
        },
        {
          "command": "co.mips.dumpText",
          "when": "false"
        },
        {
          "command": "co.mips.dumpKernelText",
          "when": "false"
        },
        {
          "command": "co.verilog.generateTestbench",
          "when": "false"
        },
        {
          "command": "co.verilog.generateIseProject",
          "when": "false"
        },
        {
          "command": "co.verilog.checkSyntaxWithIse",
          "when": "false"
        },
        {
          "command": "co.verilog.runIsim",
          "when": "false"
        },
        {
          "command": "co.verilog.openIsimWaveform",
          "when": "false"
        },
        {
          "command": "co.verilog.exportVcd",
          "when": "false"
        },
        {
          "command": "co.verilog.inspectSignal",
          "when": "false"
        },
        {
          "command": "co.logisim.generateRom",
          "when": "false"
        },
        {
          "command": "co.logisim.injectRomIntoCircuit",
          "when": "false"
        },
        {
          "command": "co.logisim.convertLogToCsv",
          "when": "false"
        },
        {
          "command": "co.logisim.openCurrentCircuit",
          "when": "false"
        },
        {
          "command": "co.hazard.analyzeCurrentMachineCode",
          "when": "false"
        },
        {
          "command": "co.hazard.openReport",
          "when": "false"
        },
        {
          "command": "co.test.compareTraceFiles",
          "when": "false"
        },
        {
          "command": "co.test.compareLatestOutputs",
          "when": "false"
        },
        {
          "command": "co.test.runFullTest",
          "when": "false"
        },
        {
          "command": "co.test.runBatchTraceTests",
          "when": "false"
        },
        {
          "command": "co.test.runGeneratedTraceTests",
          "when": "false"
        },
        {
          "command": "co.test.generateAsmTests",
