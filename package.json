{
  "name": "buaa-co-extension",
  "displayName": "BUAA CO Toolkit",
  "description": "VSCode toolkit for BUAA Computer Organization labs: Logisim, MARS/MIPS ASM, and Verilog support.",
  "version": "0.1.0",
  "publisher": "buaa-co",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:mipsasm",
    "onLanguage:verilog",
    "onLanguage:xml",
    "workspaceContains:**/*.circ",
    "onCommand:co.checkToolchain",
    "onCommand:co.selectProjectProfile",
    "onCommand:co.sidebar.refresh",
    "onCommand:co.projectWizard",
    "onCommand:co.course.openTutorial",
    "onCommand:co.course.openProfileTutorial",
    "onCommand:co.course.openTutorialLink",
    "onCommand:co.diagnostics.disableCode",
    "onCommand:co.mips.disablePseudoWarnings",
    "onCommand:co.mips.runCurrentFile",
    "onCommand:co.mips.runAndCapture",
    "onCommand:co.mips.runWithStdinFile",
    "onCommand:co.mips.runInTerminal",
    "onCommand:co.mips.dumpText",
    "onCommand:co.mips.dumpKernelText",
    "onCommand:co.verilog.generateTestbench",
    "onCommand:co.verilog.generateIseProject",
    "onCommand:co.verilog.runIsim",
    "onCommand:co.logisim.generateRom",
    "onCommand:co.logisim.injectRomIntoCircuit",
    "onCommand:co.logisim.convertLogToCsv",
    "onCommand:co.logisim.openCurrentCircuit",
    "onCommand:co.hazard.analyzeCurrentMachineCode",
    "onCommand:co.hazard.openReport",
    "onCommand:co.test.compareTraceFiles",
    "onCommand:co.test.compareLatestOutputs",
    "onCommand:co.test.runFullTest",
    "onCommand:co.test.runBatchTraceTests",
    "onCommand:co.test.runGeneratedTraceTests",
    "onCommand:co.test.startContinuousGeneratedTraceTests",
    "onCommand:co.test.stopContinuousTests",
    "onCommand:co.test.prepareLogisimCases",
    "onCommand:co.test.prepareGeneratedLogisimCases",
    "onCommand:co.test.openBatchTraceReport",
    "onView:coSidebar"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coSidebarContainer",
          "title": "BUAA CO",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "coSidebarContainer": [
        {
          "id": "coSidebar",
          "name": "BUAA CO Toolkit",
          "icon": "$(circuit-board)",
          "contextualTitle": "BUAA CO"
        }
      ]
    },
    "languages": [
      {
        "id": "mipsasm",
        "aliases": [
          "MIPS ASM",
          "mipsasm"
        ],
        "extensions": [
          ".asm",
          ".s",
          ".mips"
        ],
        "configuration": "./language-configuration/mipsasm.json"
      },
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v"
        ],
        "configuration": "./language-configuration/verilog.json"
      }
    ],
    "grammars": [
      {
        "language": "mipsasm",
        "scopeName": "source.mips",
        "path": "./syntaxes/mips.tmLanguage.json"
      },
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "./syntaxes/verilog.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mipsasm",
        "path": "./snippets/mipsasm.json"
      },
      {
        "language": "verilog",
        "path": "./snippets/verilog.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "mipsDirective",
        "superType": "keyword",
        "description": "MIPS assembler directive such as .data, .text, .eqv, or .macro."
      },
      {
        "id": "mipsInstruction",
        "superType": "function",
        "description": "MIPS instruction in single-color mode."
      },
      {
        "id": "mipsRealInstruction",
        "superType": "function",
        "description": "MIPS non-pseudo instruction in real-vs-pseudo mode."
      },
      {
        "id": "mipsRInstruction",
        "superType": "function",
        "description": "MIPS R-type instruction."
      },
      {
        "id": "mipsIInstruction",
        "superType": "function",
        "description": "MIPS I-type instruction."
      },
      {
        "id": "mipsJInstruction",
        "superType": "function",
        "description": "MIPS J-type instruction."
      },
      {
        "id": "mipsSpecialInstruction",
        "superType": "function",
        "description": "MIPS special instruction such as syscall, break, eret, or CP0 moves."
      },
      {
        "id": "mipsPseudoInstruction",
        "superType": "function",
        "description": "MIPS pseudo instruction or assembler idiom."
      },
      {
        "id": "mipsRegister",
        "superType": "variable",
        "description": "MIPS register such as $t0, $s0, or $zero."
      },
      {
        "id": "mipsCp0Register",
        "superType": "variable",
        "description": "MIPS CP0 register such as $12 Status, $13 Cause, or $14 EPC."
      },
      {
        "id": "mipsMacro",
        "superType": "function",
        "description": "MIPS assembler macro definition or macro call."
      },
      {
        "id": "mipsMacroParameter",
        "superType": "parameter",
        "description": "MIPS macro parameter such as %i."
      },
      {
        "id": "mipsLabel",
        "superType": "variable",
        "description": "MIPS text label definition or reference."
      },
      {
        "id": "mipsDataSymbol",
        "superType": "variable",
        "description": "MIPS data segment symbol."
      },
      {
        "id": "mipsEqvSymbol",
        "superType": "variable",
        "description": "MIPS .eqv symbol."
      },
      {
        "id": "mipsNumber",
        "superType": "number",
        "description": "MIPS numeric literal."
      },
      {
        "id": "mipsString",
        "superType": "string",
        "description": "MIPS string literal."
      },
      {
        "id": "mipsComment",
        "superType": "comment",
        "description": "MIPS line comment."
      },
      {
        "id": "mipsPunctuation",
        "superType": "operator",
        "description": "MIPS punctuation such as comma, colon, and parentheses."
      },
      {
        "id": "verilogModule",
        "superType": "class",
        "description": "Verilog module declarations and module type references."
      },
      {
        "id": "verilogPort",
        "superType": "property",
        "description": "Verilog ports and named port connections."
      },
      {
        "id": "verilogSignal",
        "superType": "variable",
        "description": "Verilog nets, registers, logic signals, integers, and genvars."
      },
      {
        "id": "verilogParameter",
        "superType": "enumMember",
        "description": "Verilog parameters and localparams."
      },
      {
        "id": "verilogInstance",
        "superType": "variable",
        "description": "Verilog module instance names."
      },
      {
        "id": "verilogMacro",
        "superType": "function",
        "description": "Verilog preprocessor macros."
      },
      {
        "id": "verilogSystemTask",
        "superType": "function",
        "description": "Verilog system tasks such as $display and $readmemh."
      },
      {
        "id": "verilogNumber",
        "superType": "number",
        "description": "Verilog numeric literals."
      },
      {
        "id": "verilogKeyword",
        "superType": "keyword",
        "description": "Verilog keywords."
      },
      {
        "id": "verilogComment",
        "superType": "comment",
        "description": "Verilog comments."
      },
      {
        "id": "verilogString",
        "superType": "string",
        "description": "Verilog string literals."
      },
      {
        "id": "verilogFormatSpecifier",
        "superType": "regexp",
        "description": "Verilog display format specifiers such as %d, %h, or %0d."
      },
      {
        "id": "verilogPunctuation",
        "superType": "operator",
        "description": "Verilog punctuation."
      }
    ],
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true,
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "mipsDirective": "#C586C0",
          "mipsInstruction": "#9CDCFE",
          "mipsRealInstruction": "#9CDCFE",
          "mipsRInstruction": "#9CDCFE",
          "mipsIInstruction": "#4EC9B0",
          "mipsJInstruction": "#569CD6",
          "mipsSpecialInstruction": "#F44747",
          "mipsPseudoInstruction": "#D7BA7D",
          "mipsRegister": "#4FC1FF",
          "mipsCp0Register": "#B8D7FF",
          "mipsMacro": "#569CD6",
          "mipsMacroParameter": "#FFCB6B",
          "mipsLabel": "#C586C0",
          "mipsDataSymbol": "#DCDCAA",
          "mipsEqvSymbol": "#C3E88D",
          "mipsNumber": "#B5CEA8",
          "mipsString": "#CE9178",
          "mipsComment": "#6A9955",
          "verilogModule": "#4EC9B0",
          "verilogPort": "#9CDCFE",
          "verilogSignal": "#9CDCFE",
          "verilogParameter": "#D7BA7D",
          "verilogInstance": "#DCDCAA",
          "verilogMacro": "#C586C0",
          "verilogSystemTask": "#D7BA7D",
          "verilogNumber": "#B5CEA8",
          "verilogKeyword": "#569CD6",
          "verilogComment": "#6A9955",
          "verilogString": "#CE9178",
          "verilogFormatSpecifier": "#D7BA7D"
        }
      }
    },
    "commands": [
      {
        "command": "co.checkToolchain",
        "title": "CO: Check Toolchain"
      },
      {
        "command": "co.selectProjectProfile",
        "title": "CO: Select Project Profile"
      },
      {
        "command": "co.sidebar.refresh",
        "title": "CO: Refresh Sidebar",
        "icon": "$(refresh)"
      },
      {
        "command": "co.projectWizard",
        "title": "CO: Project Wizard",
        "icon": "$(new-folder)"
      },
      {
        "command": "co.course.openTutorial",
        "title": "CO: Open Course Tutorial",
        "icon": "$(book)"
      },
      {
        "command": "co.course.openProfileTutorial",
        "title": "CO: Open Current Profile Tutorial",
        "icon": "$(symbol-class)"
      },
      {
        "command": "co.mips.runCurrentFile",
        "title": "CO: MIPS Run Current File"
      },
      {
        "command": "co.mips.runAndCapture",
        "title": "CO: MIPS Run And Capture Output"
      },
      {
        "command": "co.mips.runWithStdinFile",
        "title": "CO: MIPS Run Current File With Stdin File"
      },
      {
        "command": "co.mips.runInTerminal",
        "title": "CO: MIPS Run Current File In Terminal",
        "icon": {
          "light": "icons/run-terminal-light.svg",
          "dark": "icons/run-terminal-dark.svg"
        }
      },
      {
        "command": "co.mips.dumpText",
        "title": "CO: MIPS Dump Text Segment",
        "icon": {
          "light": "icons/dump-text-light.svg",
          "dark": "icons/dump-text-dark.svg"
        }
      },
      {
        "command": "co.mips.dumpKernelText",
        "title": "CO: MIPS Dump Kernel Text Segment"
      },
      {
        "command": "co.verilog.generateTestbench",
        "title": "CO: Verilog Generate Testbench"
      },
      {
        "command": "co.verilog.generateIseProject",
        "title": "CO: Verilog Generate ISE PRJ/TCL"
      },
      {
        "command": "co.verilog.runIsim",
        "title": "CO: Verilog Run ISim",
        "icon": {
          "light": "icons/run-isim-light.svg",
          "dark": "icons/run-isim-dark.svg"
        }
      },
      {
        "command": "co.logisim.generateRom",
        "title": "CO: Logisim Generate ROM File"
      },
      {
        "command": "co.logisim.injectRomIntoCircuit",
        "title": "CO: Logisim Inject ROM Into Circuit"
      },
      {
        "command": "co.logisim.convertLogToCsv",
        "title": "CO: Logisim Convert Logging To CSV"
      },
      {
        "command": "co.logisim.openCurrentCircuit",
        "title": "CO: Logisim Open Current Circuit",
        "icon": {
          "light": "icons/open-circuit-light.svg",
          "dark": "icons/open-circuit-dark.svg"
        }
      },
      {
        "command": "co.hazard.analyzeCurrentMachineCode",
        "title": "CO: Analyze Pipeline Hazards"
      },
      {
        "command": "co.hazard.openReport",
        "title": "CO: Open Hazard Report"
      },
      {
        "command": "co.test.compareTraceFiles",
        "title": "CO: Compare Trace Output Files"
      },
      {
        "command": "co.test.compareLatestOutputs",
        "title": "CO: Compare Latest MARS/ISim Outputs"
      },
      {
        "command": "co.test.runFullTest",
        "title": "CO: Run Full Course Trace Test"
      },
      {
        "command": "co.test.runBatchTraceTests",
        "title": "CO: Run Batch Course Trace Tests"
      },
      {
        "command": "co.test.runGeneratedTraceTests",
        "title": "CO: Run Generated Course Trace Tests"
      },
      {
        "command": "co.test.startContinuousGeneratedTraceTests",
        "title": "CO: Start Continuous Generated Course Trace Tests"
      },
      {
        "command": "co.test.stopContinuousTests",
        "title": "CO: Stop Continuous Course Tests"
      },
      {
        "command": "co.test.prepareLogisimCases",
        "title": "CO: Prepare Logisim Circuit Cases"
      },
      {
        "command": "co.test.prepareGeneratedLogisimCases",
        "title": "CO: Prepare Generated Logisim Circuit Cases"
      },
      {
        "command": "co.test.openBatchTraceReport",
        "title": "CO: Open Batch Course Trace Report"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "co.sidebar.refresh",
          "when": "view == coSidebar",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "co.mips.runInTerminal",
          "when": "resourceLangId == mipsasm",
          "group": "navigation@10"
        },
        {
          "command": "co.mips.dumpText",
          "when": "resourceLangId == mipsasm",
          "group": "navigation@11"
        },
        {
          "command": "co.verilog.runIsim",
          "when": "resourceLangId == verilog",
          "group": "navigation@10"
        },
        {
          "command": "co.logisim.openCurrentCircuit",
          "when": "resourceExtname == .circ",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "co.logisim.generateRom",
          "when": "resourceLangId == mipsasm || resourceExtname == .circ",
          "group": "co@10"
        },
        {
          "command": "co.logisim.injectRomIntoCircuit",
          "when": "resourceExtname == .circ || resourceLangId == mipsasm",
          "group": "co@11"
        },
        {
          "command": "co.verilog.generateTestbench",
          "when": "resourceLangId == verilog",
          "group": "co@10"
        },
        {
          "command": "co.verilog.generateIseProject",
          "when": "resourceLangId == verilog",
          "group": "co@11"
        }
      ],
      "commandPalette": [
        {
          "command": "co.checkToolchain"
        },
        {
          "command": "co.selectProjectProfile"
        },
        {
          "command": "co.sidebar.refresh"
        },
        {
          "command": "co.projectWizard"
        },
        {
          "command": "co.course.openTutorial"
        },
        {
          "command": "co.course.openProfileTutorial"
        },
        {
          "command": "co.mips.runCurrentFile"
        },
        {
          "command": "co.mips.runAndCapture"
        },
        {
          "command": "co.mips.runWithStdinFile"
        },
        {
          "command": "co.mips.runInTerminal"
        },
        {
          "command": "co.mips.dumpText"
        },
        {
          "command": "co.mips.dumpKernelText"
        },
        {
          "command": "co.verilog.generateTestbench"
        },
        {
          "command": "co.verilog.generateIseProject"
        },
        {
          "command": "co.verilog.runIsim"
        },
        {
          "command": "co.logisim.generateRom"
        },
        {
          "command": "co.logisim.injectRomIntoCircuit"
        },
        {
          "command": "co.logisim.convertLogToCsv"
        },
        {
          "command": "co.logisim.openCurrentCircuit"
        },
        {
          "command": "co.hazard.analyzeCurrentMachineCode"
        },
        {
          "command": "co.hazard.openReport"
        },
        {
          "command": "co.test.compareTraceFiles"
        },
        {
          "command": "co.test.compareLatestOutputs"
        },
        {
          "command": "co.test.runFullTest"
        },
        {
          "command": "co.test.runBatchTraceTests"
        },
        {
          "command": "co.test.runGeneratedTraceTests"
        },
        {
          "command": "co.test.startContinuousGeneratedTraceTests"
        },
        {
          "command": "co.test.stopContinuousTests"
        },
        {
          "command": "co.test.prepareLogisimCases"
        },
        {
          "command": "co.test.prepareGeneratedLogisimCases"
        },
        {
          "command": "co.test.openBatchTraceReport"
        }
      ]
    },
    "configuration": {
      "title": "BUAA CO Toolkit",
      "properties": {
        "co.project.profile": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "P0",
            "P1",
            "P2",
            "P3",
            "P4",
            "P5",
            "P6",
            "P7"
          ],
          "description": "Current BUAA CO project profile. Auto enables generic checks and infers some Verilog interface rules."
        },
        "co.course.tutorialRoot": {
          "type": "string",
          "default": "",
          "description": "Optional BUAA CO tutorial root. Use a local mirror path such as E:/VSCode/BUAA-CO/cscore/site/cscore.buaa.edu.cn/tutorial or a URL. Empty auto-detects a nearby local mirror and falls back to the official site."
        },
        "co.project.topModule": {
          "type": "string",
          "default": "mips",
          "description": "Top Verilog module name used by course checks and ISim project generation."
        },
        "co.project.testbench": {
          "type": "string",
          "default": "mips_tb",
          "description": "Default Verilog testbench module for ISim."
        },
        "co.project.machineCode": {
          "type": "string",
          "default": "code.txt",
          "description": "Default machine code file generated by MARS and loaded by Verilog/Logisim workflows."
        },
        "co.project.simTime": {
          "type": "string",
          "default": "200us",
          "description": "ISim TCL run duration written as `run <value>; exit`. Defaults to the BUAA CO course-style 200us."
        },
        "co.toolchain.java": {
          "type": "string",
          "default": "java",
          "description": "Java executable used for MARS and Logisim."
        },
        "co.toolchain.python": {
          "type": "string",
          "default": "python",
          "description": "Python executable used for random ASM test generators."
        },
        "co.toolchain.mars": {
          "type": "string",
          "default": "",
          "description": "Path to Mars.jar."
        },
        "co.toolchain.marsP7": {
          "type": "string",
          "default": "",
          "description": "Path to the course-specific P7 MARS jar."
        },
        "co.toolchain.logisim": {
          "type": "string",
          "default": "",
          "description": "Path to logisim.jar."
        },
        "co.toolchain.isePath": {
          "type": "string",
          "default": "",
          "description": "Path to Xilinx ISE directory, for example D:/Xilinx/14.7/ISE_DS/ISE."
        },
        "co.toolchain.hazardCalculator": {
          "type": "string",
          "default": "",
          "description": "Path to Hazard-Calculator.jar for P5/P6 pipeline hazard analysis."
        },
        "co.mips.delayedBranching": {
          "type": "string",
          "default": "profile",
          "enum": [
            "profile",
            "on",
            "off"
          ],
          "description": "Delayed branching mode for MARS commands. Profile enables it for P5/P6/P7."
        },
        "co.mips.memoryConfiguration": {
          "type": "string",
          "default": "CompactDataAtZero",
          "description": "MARS memory configuration passed after mc."
        },
        "co.mips.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments appended to every MARS command line. E.g. [\"sm\", \"dc4096\"]."
        },
        "co.mips.warnPseudoInstruction": {
          "type": "boolean",
          "default": true,
          "description": "Warn when an ASM file uses MIPS pseudo instructions."
        },
        "co.mips.instructionColorMode": {
          "type": "string",
          "default": "realVsPseudo",
          "enum": [
            "realVsPseudo",
            "same",
            "byType"
          ],
          "enumDescriptions": [
            "Use one color for real instructions and another color for pseudo instructions.",
            "Use one color for all instructions.",
            "Use separate colors for R-type, I-type, J-type, special, and pseudo instructions."
          ],
          "description": "Controls how MIPS ASM instruction semantic highlighting groups instruction colors."
        },
        "co.mips.warnMissingExitSyscall": {
          "type": "boolean",
          "default": true,
          "description": "Warn in P2 profile when the file has no syscall instruction."
        },
        "co.diagnostics.disabledCodes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Diagnostic codes to suppress in this workspace. Entries generated by quick fixes are language-qualified, for example verilog:synth-mul-div."
        },
        "co.verilog.implicitNet.diagnostic": {
          "type": "string",
          "default": "warning",
          "enum": [
            "off",
            "hint",
            "warning",
            "error"
          ],
          "description": "Severity for Verilog implicit net diagnostics."
        },
        "co.verilog.implicitNet.ignorePatterns": {
          "type": "array",
          "default": [
            "^uut\\.",
            "^tb\\."
          ],
          "items": {
            "type": "string"
          },
          "description": "Regular expressions for Verilog implicit net identifiers to ignore."
        },
        "co.verilog.lint.courseRules": {
          "type": "boolean",
          "default": true,
          "description": "Enable BUAA CO course-specific Verilog lint checks."
        },
        "co.verilog.lint.synthesizableHints": {
          "type": "boolean",
          "default": true,
          "description": "Enable informational hints for synthesizable Verilog style issues such as initial blocks, declaration initializers, and multiply/divide operators."
        },
        "co.verilog.lint.disabledRules": {
          "type": "array",
          "default": [
            "vc-001",
            "vc-003",
            "vc-004",
            "vc-008",
            "vc-014",
            "vc-017",
            "vc-021"
          ],
          "items": {
            "type": "string",
            "enum": [
              "vc-001",
              "vc-002",
              "vc-003",
              "vc-004",
              "vc-005",
              "vc-006",
              "vc-007",
              "vc-008",
              "vc-009",
              "vc-010",
              "vc-011",
              "vc-012",
              "vc-013",
              "vc-014",
              "vc-015",
              "vc-017",
              "vc-021"
            ]
          },
          "description": "Verilog course lint rule ids to suppress. VC-018, VC-019, VC-020, and VC-022 are not emitted; formatting handles spacing and indentation."
        },
        "co.verilog.format.style": {
          "type": "string",
          "default": "course",
          "enum": [
            "course",
            "compact",
            "custom"
          ],
          "enumDescriptions": [
            "BUAA CO course style based on the bundled P5/P6 project examples.",
            "A denser 4-space style with compact ranges.",
            "Use the individual co.verilog.format.* settings below."
          ],
          "description": "Controls the base style used by the Verilog formatter."
        },
        "co.verilog.format.continuationIndent": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "Extra indentation levels for module ports and instance connection continuations."
        },
        "co.verilog.format.spaceInRange": {
          "type": "boolean",
          "default": true,
          "description": "Format packed and unpacked ranges as [31: 0] instead of [31:0]."
        },
        "co.verilog.format.declarationRangeSpacing": {
          "type": "string",
          "default": "space",
          "enum": [
            "space",
            "compact",
            "preserve"
          ],
          "enumDescriptions": [
            "Keep one space before [ and after ] in declarations, for example output reg [3: 0] y.",
            "Remove spaces around declaration range brackets, for example output reg[3: 0]y.",
            "Do not change spacing around declaration range brackets."
          ],
          "description": "Controls spacing around [ and ] for input/output/inout/wire/reg declaration ranges."
        },
        "co.verilog.format.spaceBeforeInstancePorts": {
          "type": "boolean",
          "default": true,
          "description": "Keep a space before instance port lists, for example PC pc (...). Module declarations still use module m(...)."
        },
        "co.verilog.format.separateElse": {
          "type": "boolean",
          "default": true,
          "description": "Place else on a separate line after an end statement."
        },
        "co.verilog.format.maxBlankLines": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 3,
          "description": "Maximum number of consecutive blank lines preserved by the Verilog formatter."
        },
        "co.run.showCommandBeforeRun": {
          "type": "boolean",
          "default": false,
          "description": "Show the exact external command before running it."
        },
        "co.run.timeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "Timeout for external tool runs."
        },
        "co.test.generatorArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra command-line arguments appended when running a random ASM test generator."
        },
        "co.test.generatedAsmLimit": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Maximum number of new or modified ASM files picked up after a test generator run."
        },
        "co.test.builtinGenerator.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use the built-in random ASM generator by default for generated course trace tests. Open an external generator file or disable this to use the external generator picker."
        },
        "co.test.builtinGenerator.instructions": {
          "type": "string",
          "default": "",
          "description": "Instruction names allowed in the built-in random ASM generator. Separate names with any commas or whitespace. Only real instructions are accepted. Empty uses the current P3-P7 profile default."
        },
        "co.test.builtinGenerator.instructionCount": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 4000,
          "description": "Executable instruction count for each ASM file generated by the built-in random ASM generator."
        },
        "co.test.continuousIntervalMs": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "description": "Delay between continuous generated trace test iterations."
        },
        "co.test.continuousMaxIterations": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum continuous generated trace test iterations. 0 means run until stopped or failure policy triggers."
        },
        "co.test.continuousStopOnFailure": {
          "type": "boolean",
          "default": true,
          "description": "Stop a continuous generated trace test session after an iteration with failed or errored cases."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.2",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0"
  }
}
