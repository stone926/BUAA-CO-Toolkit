{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BUAA CO course contract ledger schema",
  "description": "机器可读课程契约账本。contracts.json / decisions.json / divergences.json 各自是 { schemaRevision, entries: [...] }；entry 校验使用本文件 definitions 中的 contractEntry / decisionEntry / divergenceEntry。source 路径均相对于 BUAA-CO 仓库根（extension 与 cscore 的父目录），如 cscore/markdown/P7/implement/P7-2-3.md 或 extension/resources/co/p7Hardware.json。",
  "definitions": {
    "normativeReference": {
      "type": "object",
      "required": ["source", "quote"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "lines": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1,
          "maxItems": 2,
          "description": "引用行号（单行或闭区间 [start, end]）"
        },
        "quote": { "type": "string", "minLength": 1, "description": "条款摘录或概括，用于离线核对" },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "decisionProvenance": {
      "type": "object",
      "required": ["decisionAuthority", "decidedBy", "decidedAt", "evidenceStatus", "note"],
      "properties": {
        "decisionAuthority": { "enum": ["course-contract", "official-component-arbitration", "product-owner"] },
        "decidedBy": { "type": "string", "minLength": 1 },
        "decidedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "evidenceStatus": { "enum": ["course-derived", "source-conflict-arbitrated", "out-of-domain-policy"] },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "divergenceReproduction": {
      "type": "object",
      "required": ["kind", "file", "profile", "expectedObservation", "verification"],
      "properties": {
        "kind": { "enum": ["minimal-repro", "decision-vector"] },
        "file": { "type": "string", "pattern": "^conformance/mips/" },
        "profile": { "enum": ["P3", "P4", "P5", "P6", "P7", "P56", "common"] },
        "expectedObservation": { "type": "string", "minLength": 1 },
        "verification": {
          "type": "object",
          "required": ["kind", "assertions"],
          "properties": {
            "kind": { "enum": ["legacy-differential", "course-directed-oracle", "official-rtl"] },
            "assertions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contractEntry": {
      "type": "object",
      "required": ["id", "profile", "domain", "statement", "normativeReference", "status", "revision"],
      "properties": {
        "id": { "type": "string", "pattern": "^COURSE-(P[2-7]|P56|COMMON)-[A-Z0-9-]+-[0-9]{3}$" },
        "profile": { "enum": ["P2", "P3", "P4", "P5", "P6", "P7", "P56", "common"] },
        "domain": {
          "enum": [
            "address-space", "reset-state", "isa", "delay-slot", "overflow",
            "trace-projection", "cp0", "exception", "interrupt", "timer",
            "device", "memory", "completion", "undefined-domain", "diagnostics"
          ]
        },
        "statement": { "type": "string", "minLength": 1 },
        "normativeReference": {
          "type": "array",
          "items": { "$ref": "#/definitions/normativeReference" },
          "minItems": 1
        },
        "status": { "enum": ["frozen", "pending", "superseded"] },
        "revision": { "type": "integer", "minimum": 1 },
        "supersededBy": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "decisionEntry": {
      "type": "object",
      "required": ["id", "subject", "question", "decision", "resolution", "rationale", "normativeReference", "freezeRequires", "revision"],
      "properties": {
        "id": { "type": "string", "pattern": "^COURSE-(P[2-7]|P56|COMMON)-[A-Z0-9-]+-[0-9]{3}$" },
        "subject": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1, "description": "需要裁决的歧义" },
        "decision": { "enum": ["frozen", "pending"] },
        "resolution": { "type": "string", "minLength": 1, "description": "已冻结的裁决内容；pending 时写明倾向方案" },
        "rationale": { "type": "string", "minLength": 1 },
        "normativeReference": {
          "type": "array",
          "items": { "$ref": "#/definitions/normativeReference" },
          "minItems": 1
        },
        "freezeRequires": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "冻结前必须完成的验证/向量"
        },
        "scope": { "enum": ["course-normative", "official-component", "product-policy", "mixed"] },
        "provenance": { "$ref": "#/definitions/decisionProvenance" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "divergenceEntry": {
      "oneOf": [
        { "$ref": "#/definitions/marsDivergenceEntry" },
        { "$ref": "#/definitions/sourceConflictDivergenceEntry" }
      ]
    },
    "marsDivergenceEntry": {
      "type": "object",
      "required": ["id", "category", "domain", "subject", "marsBehavior", "courseBehavior", "pluginHandling", "sources", "reproduction", "revision"],
      "properties": {
        "id": { "type": "string", "pattern": "^MARS-DIV-[A-Z0-9-]+-[0-9]{3}$" },
        "category": { "enum": ["mars-bug", "course-correct", "format-only"] },
        "domain": { "enum": ["assembler", "execution", "device", "trace-format"] },
        "subject": { "type": "string", "minLength": 1 },
        "marsBehavior": { "type": "string", "minLength": 1 },
        "courseBehavior": { "type": "string", "minLength": 1 },
        "pluginHandling": { "type": "string", "minLength": 1, "description": "插件当前如何检测/拒绝/修复" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/normativeReference" },
          "minItems": 1
        },
        "reproduction": { "$ref": "#/definitions/divergenceReproduction" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "sourceConflictDivergenceEntry": {
      "type": "object",
      "required": ["id", "category", "domain", "subject", "sourceABehavior", "sourceBBehavior", "resolution", "pluginHandling", "sources", "reproduction", "revision"],
      "properties": {
        "id": { "type": "string", "pattern": "^COURSE-DIV-[A-Z0-9-]+-[0-9]{3}$" },
        "category": { "const": "source-conflict" },
        "domain": { "enum": ["execution", "device"] },
        "subject": { "type": "string", "minLength": 1 },
        "sourceABehavior": { "type": "string", "minLength": 1 },
        "sourceBBehavior": { "type": "string", "minLength": 1 },
        "resolution": { "type": "string", "minLength": 1 },
        "pluginHandling": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/normativeReference" },
          "minItems": 2
        },
        "reproduction": { "$ref": "#/definitions/divergenceReproduction" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "contractLedger": {
      "type": "object",
      "required": ["schemaRevision", "entries"],
      "properties": {
        "schemaRevision": { "type": "integer", "minimum": 1 },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/definitions/contractEntry" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "decisionLedger": {
      "type": "object",
      "required": ["schemaRevision", "entries"],
      "properties": {
        "schemaRevision": { "type": "integer", "minimum": 1 },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/definitions/decisionEntry" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "divergenceLedger": {
      "type": "object",
      "required": ["schemaRevision", "entries"],
      "properties": {
        "schemaRevision": { "type": "integer", "minimum": 1 },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/definitions/divergenceEntry" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "uniqueStringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "nonEmptyUniqueStringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidenceGateValue": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "minLength": 1 }
      ]
    },
    "evidenceKind": {
      "type": "object",
      "required": ["kind", "unit", "fingerprintExcludes", "fingerprintIncludes", "initialGate", "coverageBins"],
      "properties": {
        "kind": { "enum": ["assembly", "execution", "device", "full-stack"] },
        "unit": { "type": "string", "minLength": 1 },
        "fingerprintExcludes": { "$ref": "#/definitions/uniqueStringArray" },
        "fingerprintIncludes": { "$ref": "#/definitions/nonEmptyUniqueStringArray" },
        "initialGate": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/evidenceGateValue" }
        },
        "coverageBins": { "$ref": "#/definitions/nonEmptyUniqueStringArray" }
      },
      "additionalProperties": false
    },
    "evidenceGateDocument": {
      "type": "object",
      "required": ["schemaRevision", "description", "evidenceKinds", "seedManifestFields", "invalidTransitionPolicy", "status", "revision"],
      "properties": {
        "schemaRevision": { "enum": [1] },
        "description": { "type": "string", "minLength": 1 },
        "evidenceKinds": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidenceKind" },
          "minItems": 4,
          "maxItems": 4
        },
        "seedManifestFields": { "$ref": "#/definitions/nonEmptyUniqueStringArray" },
        "invalidTransitionPolicy": { "type": "string", "minLength": 1 },
        "status": { "enum": ["structure-frozen"] },
        "revision": { "enum": [1] }
      },
      "additionalProperties": false
    }
  }
}
