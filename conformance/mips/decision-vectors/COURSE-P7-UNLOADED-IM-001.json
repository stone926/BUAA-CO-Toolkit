{
  "schemaRevision": 1,
  "id": "COURSE-P7-UNLOADED-IM-001",
  "profile": "P7",
  "scope": "product-policy",
  "approvedBy": "stone926",
  "approvedAt": "2026-08-26",
  "policy": {
    "strict": "out-of-domain",
    "exploratory": "explicit-synthetic-zero-fill",
    "missingWordException": "none"
  },
  "vectors": [
    {
      "id": "strict-jump-to-missing-word",
      "input": { "pc": "0x00003100", "image": { "0x00003000": "0x08000c40", "0x00003004": "0x00000000" }, "mode": "strict" },
      "expected": { "status": "out-of-domain", "reason": "unloaded-instruction", "instruction": null, "synthetic": false, "exception": null }
    },
    {
      "id": "exploratory-zero-fill-is-marked",
      "input": { "pc": "0x00003100", "image": { "0x00003000": "0x08000c40", "0x00003004": "0x00000000" }, "mode": "exploratory-zero-fill" },
      "expected": { "status": "execute", "reason": "synthetic-zero-fill", "instruction": "0x00000000", "synthetic": true, "exception": null }
    },
    {
      "id": "explicit-loaded-zero-is-real-nop",
      "input": { "pc": "0x00003100", "image": { "0x00003100": "0x00000000" }, "mode": "strict" },
      "expected": { "status": "execute", "reason": "loaded", "instruction": "0x00000000", "synthetic": false, "exception": null }
    },
    {
      "id": "outside-im-remains-adel",
      "input": { "pc": "0x00007000", "image": {}, "mode": "strict" },
      "expected": { "status": "exception", "reason": "invalid-fetch-address", "instruction": null, "synthetic": false, "exception": "AdEL" }
    },
    {
      "id": "misaligned-im-remains-adel",
      "input": { "pc": "0x00003102", "image": {}, "mode": "strict" },
      "expected": { "status": "exception", "reason": "invalid-fetch-address", "instruction": null, "synthetic": false, "exception": "AdEL" }
    }
  ]
}
