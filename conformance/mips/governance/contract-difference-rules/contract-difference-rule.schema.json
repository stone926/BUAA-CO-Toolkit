{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BUAA CO declarative contract difference rule",
  "type": "object",
  "required": [
    "schemaRevision", "kind", "id", "candidate", "domain",
    "capabilityScope", "inputPredicate", "eventAndFieldScope",
    "marsBehavior", "courseBehavior", "expectedRelationOrTransform",
    "normativeReference", "directedTests", "criticalMutants", "revision"
  ],
  "properties": {
    "schemaRevision": { "const": 1 },
    "kind": { "const": "contractDifferenceRule" },
    "id": { "type": "string", "pattern": "^COURSE-[A-Z0-9-]{3,120}$" },
    "candidate": { "$ref": "#/definitions/candidate" },
    "domain": { "enum": ["assembler", "execution", "device"] },
    "capabilityScope": {
      "type": "object",
      "required": ["profiles", "capabilities"],
      "properties": {
        "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["P3", "P4", "P5", "P6", "P7"] } },
        "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$" } }
      },
      "additionalProperties": false
    },
    "inputPredicate": {
      "type": "object",
      "required": ["all"],
      "properties": {
        "all": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/definitions/predicateClause" } }
      },
      "additionalProperties": false
    },
    "eventAndFieldScope": { "$ref": "#/definitions/eventAndFieldScope" },
    "marsBehavior": { "type": "string", "minLength": 1 },
    "courseBehavior": { "type": "string", "minLength": 1 },
    "expectedRelationOrTransform": {
      "type": "object",
      "required": ["kind", "description"],
      "properties": {
        "kind": { "enum": ["reject-legacy-result", "replace-exact-field", "merge-exact-events", "classify-format-only", "select-course-vector"] },
        "description": { "type": "string", "minLength": 1 },
        "fromValue": { "type": ["string", "number", "boolean", "null"] },
        "toValue": { "type": ["string", "number", "boolean", "null"] }
      },
      "additionalProperties": false
    },
    "normativeReference": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/normativeReference" } },
    "directedTests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$" } },
    "criticalMutants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$" } },
    "revision": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false,
  "definitions": {
    "candidate": {
      "type": "object",
      "required": ["author", "revision"],
      "properties": {
        "author": { "type": "string", "pattern": "^(?!.*--)[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "predicateClause": {
      "type": "object",
      "required": ["field", "operator", "value"],
      "properties": {
        "field": { "enum": ["profile", "mnemonic", "sourceSha256", "imageSha256", "imageWordCount", "pc", "address", "eventKind", "eventIndex"] },
        "operator": { "enum": ["equals", "oneOf", "betweenInclusive"] },
        "value": {
          "oneOf": [
            { "type": ["string", "integer", "boolean"] },
            { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": ["string", "integer", "boolean"] } }
          ]
        }
      },
      "additionalProperties": false
    },
    "eventAndFieldScope": {
      "type": "object",
      "required": ["events", "fields"],
      "properties": {
        "events": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$" } },
        "fields": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9.[\\]-]{1,127}$" } }
      },
      "additionalProperties": false
    },
    "normativeReference": {
      "type": "object",
      "required": ["contractId", "source", "quote"],
      "properties": {
        "contractId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,127}$" },
        "source": { "type": "string", "minLength": 1 },
        "lines": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } },
        "quote": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
