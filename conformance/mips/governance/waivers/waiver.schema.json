{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BUAA CO one-case intentional divergence waiver",
  "type": "object",
  "required": [
    "schemaRevision", "kind", "id", "candidate", "category",
    "caseFingerprint", "engineFingerprint", "contractRevision",
    "normalizerRevision", "rawOracleHash", "expectedCanonicalHash",
    "actualCanonicalHash", "mismatchSha256", "eventAndFieldScope",
    "minimalRepro", "marsBehavior", "expectedTsBehavior",
    "normativeReference", "owner", "created", "expiresAt",
    "lastMatchedEvidence"
  ],
  "properties": {
    "schemaRevision": { "const": 1 },
    "kind": { "const": "waiver" },
    "id": { "type": "string", "pattern": "^WAIVER-[A-Z0-9-]{3,120}$" },
    "candidate": { "$ref": "#/definitions/candidate" },
    "category": { "enum": ["mars-bug", "course-correct", "format-only"] },
    "caseFingerprint": { "$ref": "#/definitions/sha256" },
    "engineFingerprint": { "$ref": "#/definitions/sha256" },
    "contractRevision": { "type": "integer", "minimum": 1 },
    "normalizerRevision": { "type": "integer", "minimum": 1 },
    "rawOracleHash": { "$ref": "#/definitions/sha256" },
    "expectedCanonicalHash": { "$ref": "#/definitions/sha256" },
    "actualCanonicalHash": { "$ref": "#/definitions/sha256" },
    "mismatchSha256": { "$ref": "#/definitions/sha256" },
    "eventAndFieldScope": { "$ref": "#/definitions/eventAndFieldScope" },
    "minimalRepro": {
      "type": "object",
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "pattern": "^(?:corpus|governance)/[A-Za-z0-9._/-]+$" },
        "sha256": { "$ref": "#/definitions/sha256" }
      },
      "additionalProperties": false
    },
    "marsBehavior": { "type": "string", "minLength": 1 },
    "expectedTsBehavior": { "type": "string", "minLength": 1 },
    "normativeReference": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/normativeReference" } },
    "owner": { "type": "string", "pattern": "^(?!.*--)[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
    "created": { "$ref": "#/definitions/date" },
    "expiresAt": { "$ref": "#/definitions/date" },
    "lastMatchedEvidence": {
      "type": "object",
      "required": ["caseFingerprint", "mismatchSha256", "matchedAt"],
      "properties": {
        "caseFingerprint": { "$ref": "#/definitions/sha256" },
        "mismatchSha256": { "$ref": "#/definitions/sha256" },
        "matchedAt": { "$ref": "#/definitions/date" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "date": { "type": "string", "pattern": "^20[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$" },
    "candidate": {
      "type": "object",
      "required": ["author", "revision"],
      "properties": {
        "author": { "type": "string", "pattern": "^(?!.*--)[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "eventAndFieldScope": {
      "type": "object",
      "required": ["events", "fields"],
      "properties": {
        "events": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$" } },
        "fields": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9.[\\]-]{1,127}$" } }
      },
      "additionalProperties": false
    },
    "normativeReference": {
      "type": "object",
      "required": ["contractId", "source", "quote"],
      "properties": {
        "contractId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,127}$" },
        "source": { "type": "string", "minLength": 1 },
        "lines": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } },
        "quote": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
