{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BUAA CO phase-0 approval envelope",
  "type": "object",
  "required": ["schemaRevision", "kind", "subject", "review", "integrity"],
  "properties": {
    "schemaRevision": { "const": 1 },
    "kind": { "const": "phase0-artifact-approval" },
    "subject": {
      "type": "object",
      "required": [
        "artifactKind",
        "artifactId",
        "candidatePath",
        "candidateSha256",
        "candidateAuthor",
        "candidateRevision"
      ],
      "properties": {
        "artifactKind": {
          "enum": [
            "corpus",
            "courseVector",
            "marsGolden",
            "isaGolden",
            "contractDifferenceRule",
            "waiver"
          ]
        },
        "artifactId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
        "candidatePath": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{2,511}\\.json$" },
        "candidateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "candidateAuthor": { "type": "string", "pattern": "^(?!.*--)[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
        "candidateRevision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status", "reviewer", "reviewedAt", "reviewRevision"],
      "properties": {
        "status": { "const": "approved" },
        "reviewer": { "const": "stone926" },
        "reviewedAt": { "type": "string", "pattern": "^20[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$" },
        "reviewRevision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "envelopeSha256"],
      "properties": {
        "algorithm": { "const": "sha256-canonical-json-v1" },
        "envelopeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
