{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buaa-co-toolkit.invalid/conformance/course-vector.schema.json",
  "title": "Independent BUAA CO courseVector artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaRevision",
    "caseId",
    "profile",
    "vectorKind",
    "source",
    "provenance",
    "review",
    "execution",
    "expected",
    "observability",
    "integrity"
  ],
  "properties": {
    "schemaRevision": { "const": 1 },
    "caseId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{2,127}$" },
    "profile": { "enum": ["P3", "P4", "P5", "P6", "P7"] },
    "vectorKind": { "enum": ["program-final-state", "cp0-sequence", "timer-sequence", "external-irq-sequence"] },
    "source": { "type": "object" },
    "provenance": { "type": "object" },
    "review": { "type": "object" },
    "execution": { "type": "object" },
    "expected": { "type": "object" },
    "observability": { "type": "object" },
    "integrity": { "type": "object" }
  },
  "$comment": "The dependency-free JS validator in runner/courseVectorArtifact.mjs is authoritative and enforces the full discriminated schema plus independent CP0/Timer/IRQ oracles."
}
