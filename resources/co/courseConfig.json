  "profileInference": {
    "topModuleNames": ["mips", "cpu"],
    "p6RequiredPorts": [
      "clk",
      "reset",
      "i_inst_rdata",
      "m_data_rdata",
      "i_inst_addr",
      "m_data_addr",
      "m_data_wdata",
      "m_data_byteen",
      "m_inst_addr",
      "w_grf_addr",
      "w_grf_wdata",
      "w_grf_we",
      "w_inst_addr"
    ],
    "p7ExclusivePorts": ["interrupt", "macroscopic_pc", "m_int_addr", "m_int_byteen"],
    "p7Structure": {
      "cp0ModuleNames": ["cp0"],
      "cp0ModuleNameIncludes": ["cp0"],
      "cp0DeclarationHints": ["sr", "cause", "epc"],
      "bridgeModuleNames": ["bridge"],
      "timerModuleNames": ["tc", "timer", "timer0", "timer1"]
    },
    "logisimCpuPathPatterns": [
      "(^|/)(p3|cpu|rom|test|code\\.txt)(/|$)",
      "(^|/)code\\.txt$"
    ]
  },
  "logisimTrace": {
    "P3": {
      "defaultCircuit": "main",
      "textBase": "0x00003000",
      "romMaxWords": 4096,
      "haltLoopWords": 2,
      "pcAlignmentBytes": 4,
      "stuckPcRowLimit": 256,
      "haltLabel": "halt",
      "orderedColumns": ["instr", "pc", "regwrite", "regaddr", "regdata", "memwrite", "memaddr", "memdata"],
      "columns": {
        "instr": {
          "width": 32,
          "required": false,
          "aliases": ["instr", "instruction"]
        },
        "pc": {
          "width": 32,
          "required": true,
          "aliases": ["pc"]
        },
        "regwrite": {
          "width": 1,
          "required": true,
          "aliases": ["regwrite", "regwe", "grfwrite"]
        },
        "regaddr": {
          "width": 5,
          "required": true,
          "aliases": ["regaddr", "regaddress", "grfaddr", "grfaddress"]
        },
        "regdata": {
          "width": 32,
          "required": true,
          "aliases": ["regdata", "regwdata", "grfdata", "grfwdata"]
        },
        "memwrite": {
          "width": 1,
          "required": true,
          "aliases": ["memwrite", "memwe", "dmwrite"]
        },
        "memaddr": {
          "width": 32,
          "required": true,
          "aliases": ["memaddr", "memaddress", "dmaddr", "dmaddress"]
        },
        "memdata": {
          "width": 32,
          "required": true,
          "aliases": ["memdata", "memwdata", "dmdata", "dmwdata"]
        }
      }
    }
  },
  "directiveDescriptions": {
    ".data": "数据段",
    ".text": "代码段",
    ".kdata": "内核数据段",
    ".ktext": "内核代码段",
    ".word": "存储 32 位字",
    ".half": "存储 16 位半字",
    ".byte": "存储 8 位字节",
    ".ascii": "存储 ASCII 字符串（不含终止符）",
    ".asciiz": "存储以 0 结尾的 ASCII 字符串",
    ".space": "分配指定字节数的空间",
    ".align": "按 2^n 字节边界对齐",
    ".globl": "声明全局符号",
    ".extern": "声明外部符号",
    ".eqv": "定义符号常量",
    ".macro": "开始宏定义",
    ".end_macro": "结束宏定义",
    ".include": "引用外部文件"
  },
  "directiveDetails": {
    ".align": {
      "description": "按 2^n 字节边界对齐下一个数据项",
      "commonValues": {
        "0": "1 字节对齐",
        "1": "2 字节对齐",
        "2": "4 字节对齐"
      }
    },
    ".data": {
      "description": "数据段。使用 CompactDataAtZero 配置，不应自定义段地址"
    },
    ".text": {
      "description": "代码段。使用 CompactDataAtZero 配置，不应自定义段地址"
    }
  },
  "traceFormatPatterns": {
    "P4": [
      "@%0?\\d*h:(?:\\$%0?\\d*d<=%0?\\d*h|\\*%0?\\d*h<=%0?\\d*h)"
    ],
    "P5": [
      "%0?\\d*d@%0?\\d*h:(?:\\$%0?\\d*d<=%0?\\d*h|\\*%0?\\d*h<=%0?\\d*h)"
    ]
  }
}
