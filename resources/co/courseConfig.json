{
  "memoryLayout": {
    "CompactDataAtZero": {
      "data": {
        "min": "0x00000000",
        "max": "0x00002fff",
        "label": "0x00000000-0x00002fff"
      },
      "text": {
        "min": "0x00003000",
        "max": "0x00006fff",
        "label": "0x00003000-0x00006fff"
      },
      "ktext": {
        "min": "0x00004180",
        "max": "0x00004ffc",
        "label": "0x00004180-0x00004ffc"
      }
    }
  },
  "verilogTestbench": {
    "externalInstructionMemoryWords": 4096,
    "externalDataMemoryWords": 3072
  },
  "profiles": {
