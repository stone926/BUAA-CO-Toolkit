          "ori $at, $at, ${imm:lower16}",
          "bne $at, ${rs}, ${label}"
        ]
      }
    ]
  },
  "blt": {
    "description": "有符号小于时跳转（Branch if Less Than）",
    "forms": [
      {
        "operands": [
          "$rs",
          "$rt",
          "label"
        ],
        "template": [
