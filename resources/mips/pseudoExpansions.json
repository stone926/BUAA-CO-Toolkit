  "seq": {
    "description": "相等置1（Set EQual）：两数相等则 $rd 置1，否则置0",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs",
          "$rt"
        ],
        "template": [
          "subu ${rd}, ${rs}, ${rt}",
          "ori $at, $zero, 1",
          "sltu ${rd}, ${rd}, $at"
        ]
