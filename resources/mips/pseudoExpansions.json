          "beq $at, $zero, ${label}"
        ]
      }
    ]
  },
  "bge": {
    "description": "有符号大于等于时跳转（Branch if Greater or Equal）",
    "forms": [
      {
        "operands": [
          "$rs",
          "$rt",
          "label"
