          "imm32"
        ],
        "template": [
          "lui $at, ${imm:upper16}",
          "ori $at, $at, ${imm:lower16}",
          "xor ${rd}, ${rs}, $at"
        ]
      }
    ]
  },
  "and": {
    "description": "按位与（AND）：第二操作数为无符号16位立即数时展开为 andi",
    "forms": [
      {
        "operands": [
          "$rd",
          "imm16_unsigned"
        ],
        "template": [
          "andi ${rd}, ${rd}, ${imm:hex16}"
        ]
      },
      {
        "operands": [
          "$rd",
          "$rs",
          "imm16_unsigned"
        ],
        "template": [
          "andi ${rd}, ${rs}, ${imm:hex16}"
        ]
      }
    ]
  },
  "or": {
    "description": "按位或（OR）：第二操作数为无符号16位立即数时展开为 ori",
    "forms": [
      {
        "operands": [
          "$rd",
          "imm16_unsigned"
        ],
        "template": [
          "ori ${rd}, ${rd}, ${imm:hex16}"
        ]
      },
      {
        "operands": [
          "$rd",
          "$rs",
          "imm16_unsigned"
        ],
        "template": [
          "ori ${rd}, ${rs}, ${imm:hex16}"
        ]
      }
    ]
  },
  "xor": {
    "description": "按位异或（XOR）：第二操作数为无符号16位立即数时展开为 xori",
    "forms": [
      {
        "operands": [
          "$rd",
          "imm16_unsigned"
        ],
        "template": [
          "xori ${rd}, ${rd}, ${imm:hex16}"
        ]
      },
      {
        "operands": [
          "$rd",
          "$rs",
          "imm16_unsigned"
        ],
        "template": [
          "xori ${rd}, ${rs}, ${imm:hex16}"
        ]
      }
    ]
  },
  "mul": {
    "description": "乘法（MULtiplication）：第三操作数为立即数时展开（注意：mul 三寄存器形式为基本指令，返回 undefined）",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs",
          "imm16_signed"
        ],
        "template": [
          "addi $at, $zero, ${imm:signed16}",
          "mul ${rd}, ${rs}, $at"
        ]
      },
      {
        "operands": [
          "$rd",
          "$rs",
          "imm32"
        ],
        "template": [
          "lui $at, ${imm:upper16}",
          "ori $at, $at, ${imm:lower16}",
          "mul ${rd}, ${rs}, $at"
        ]
      }
    ]
  },
  "div": {
    "description": "除法（DIVision）：三操作数形式，取商存入 $rd",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs",
          "$rt"
        ],
        "template": [
          "bne ${rt}, $zero, 1",
          "break",
          "div ${rs}, ${rt}",
          "mflo ${rd}"
        ]
      },
      {
        "operands": [
          "$rd",
          "$rs",
          "imm32"
        ],
        "template": [
          "lui $at, ${imm:upper16}",
          "ori $at, $at, ${imm:lower16}",
          "div ${rs}, $at",
          "mflo ${rd}"
        ]
      }
    ]
  },
  "divu": {
    "description": "无符号除法（DIVision Unsigned）：三操作数形式，取商存入 $rd",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs",
          "$rt"
        ],
        "template": [
