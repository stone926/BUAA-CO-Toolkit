          "ori $at, $at, ${imm:lower16}",
          "beq $at, ${rs}, ${label}"
        ]
      }
    ]
  },
  "bne": {
    "description": "不等时跳转（Branch if Not Equal）：第二操作数为立即数时展开",
    "forms": [
      {
        "operands": [
