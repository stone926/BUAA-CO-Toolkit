{
  "loadImmediate": {
    "mnemonic": "li",
    "operands": 2,
    "description": "加载立即数到寄存器",
    "expansions": [
      {
        "condition": "value fits signed 16-bit",
        "template": ["addiu {dst}, $zero, {signed16}"]
      },
      {
        "condition": "value fits unsigned 16-bit but not signed 16-bit",
        "template": ["ori {dst}, $zero, {lower16}"]
      },
      {
        "condition": "32-bit value",
        "template": ["lui $at, {upper16}", "ori {dst}, $at, {lower16}"]
      }
    ]
  },
  "loadAddress": {
    "mnemonic": "la",
    "operands": 2,
    "description": "加载地址到寄存器",
    "template": ["lui $at, upper({src})", "ori {dst}, $at, lower({src})"]
  },
  "move": {
    "mnemonic": "move",
    "operands": 2,
    "description": "寄存器间移动",
    "template": ["addu {dst}, $zero, {src}"]
  },
  "nop": {
    "mnemonic": "nop",
    "operands": 0,
    "description": "MARS 基本空操作，机器码为 0；hover 不再作为伪指令展开展示",
    "template": ["sll $zero, $zero, 0"]
  },
  "branch": {
    "mnemonic": "b",
    "operands": 1,
    "description": "无条件跳转",
    "template": ["bgez $zero, {label}"]
  },
  "branchEqualZero": {
    "mnemonic": "beqz",
    "operands": 2,
    "description": "等于零时跳转",
    "template": ["beq {reg}, $zero, {label}"]
  },
  "branchNotEqualZero": {
    "mnemonic": "bnez",
    "operands": 2,
    "description": "不等于零时跳转",
    "template": ["bne {reg}, $zero, {label}"]
  },
  "not": {
    "mnemonic": "not",
    "operands": 2,
    "description": "按位取反",
    "template": ["nor {dst}, {src}, $zero"]
  },
  "neg": {
    "mnemonic": "neg",
    "operands": 2,
    "description": "有符号取负",
    "template": ["sub {dst}, $zero, {src}"]
  },
  "negu": {
    "mnemonic": "negu",
    "operands": 2,
    "description": "无符号取负跳转",
    "template": ["subu {dst}, $zero, {src}"]
  },
  "multiplyImmediate": {
    "mnemonic": "mul",
    "operands": 3,
    "description": "第三操作数为立即数时的 MARS 伪格式；mul $rd, $rs, $rt 是基本指令",
    "expansions": [
      {
        "condition": "immediate fits signed 16-bit",
        "template": ["addi $at, $zero, {signed16}", "mul {dst}, {src1}, $at"]
      },
      {
        "condition": "32-bit immediate",
        "template": ["lui $at, {upper16}", "ori $at, $at, {lower16}", "mul {dst}, {src1}, $at"]
      }
    ]
  },
  "divide": {
    "mnemonic": "div",
    "operands": 3,
    "description": "除法（取商）",
    "template": ["div {src1}, {src2}", "mflo {dst}"]
  },
  "divideUnsigned": {
    "mnemonic": "divu",
    "operands": 3,
    "description": "无符号除法（取商）",
    "template": ["divu {src1}, {src2}", "mflo {dst}"]
  },
  "remainder": {
    "mnemonic": "rem",
    "operands": 3,
    "description": "有符号取余",
    "template": ["div {src1}, {src2}", "mfhi {dst}"]
  },
  "remainderUnsigned": {
    "mnemonic": "remu",
    "operands": 3,
    "description": "无符号取余跳转",
    "template": ["divu {src1}, {src2}", "mfhi {dst}"]
  },
  "compareBranch": {
    "blt": {
      "description": "有符号小于时跳转跳转",
      "template": ["slt $at, {left}, {right}", "bne $at, $zero, {label}"]
    },
    "bltu": {
      "description": "无符号小于时跳转跳转",
      "template": ["sltu $at, {left}, {right}", "bne $at, $zero, {label}"]
    },
    "bgt": {
      "description": "有符号大于时跳转跳转",
      "template": ["slt $at, {right}, {left}", "bne $at, $zero, {label}"]
    },
    "bgtu": {
      "description": "无符号大于时跳转跳转",
      "template": ["sltu $at, {right}, {left}", "bne $at, $zero, {label}"]
    },
    "ble": {
      "description": "有符号小于等于时跳转跳转",
      "template": ["slt $at, {right}, {left}", "beq $at, $zero, {label}"]
    },
    "bleu": {
      "description": "无符号小于等于时跳转跳转",
      "template": ["sltu $at, {right}, {left}", "beq $at, $zero, {label}"]
    },
    "bge": {
      "description": "有符号大于等于时跳转跳转",
      "template": ["slt $at, {left}, {right}", "beq $at, $zero, {label}"]
    },
    "bgeu": {
      "description": "无符号大于等于时跳转跳转",
      "template": ["sltu $at, {left}, {right}", "beq $at, $zero, {label}"]
    }
  },
  "threeOperandArithmetic": {
    "add": {
      "description": "加法（三操作数形式）",
      "template": ["lui $at, {upper16}", "ori $at, $at, {lower16}", "add {dst}, {src}, $at"]
    },
    "addu": {
      "description": "无溢出加法（三操作数形式）",
      "template": ["lui $at, {upper16}", "ori $at, $at, {lower16}", "addu {dst}, {src}, $at"]
    },
    "sub": {
      "description": "减法（三操作数形式）",
      "template": ["lui $at, {upper16}", "ori $at, $at, {lower16}", "sub {dst}, {src}, $at"]
    },
    "subu": {
      "description": "无溢出减法（三操作数形式）",
      "template": ["lui $at, {upper16}", "ori $at, $at, {lower16}", "subu {dst}, {src}, $at"]
    }
  }
}
