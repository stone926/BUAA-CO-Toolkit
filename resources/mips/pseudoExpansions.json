{
  "li": {
    "description": "加载立即数到寄存器（Load Immediate）",
    "forms": [
      {
        "operands": [
          "$rd",
          "imm16_signed"
        ],
        "template": [
          "addiu ${rd}, $zero, ${imm:signed16}"
        ]
      },
      {
        "operands": [
          "$rd",
          "imm16_unsigned"
        ],
        "template": [
          "ori ${rd}, $zero, ${imm:hex16}"
        ]
      },
      {
        "operands": [
          "$rd",
          "imm32"
        ],
        "template": [
          "lui $at, ${imm:upper16}",
          "ori ${rd}, $at, ${imm:lower16}"
        ]
      }
    ]
  },
  "la": {
    "description": "加载标签地址到寄存器（Load Address）",
    "forms": [
      {
        "operands": [
          "$rd",
          "label"
        ],
        "template": [
          "lui $at, %hi(${label})",
          "ori ${rd}, $at, %lo(${label})"
        ]
      }
    ]
  },
  "move": {
    "description": "寄存器间数据移动（Move）",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs"
        ],
        "template": [
          "addu ${rd}, $zero, ${rs}"
        ]
      }
    ]
  },
  "b": {
    "description": "无条件跳转（Branch）",
    "forms": [
      {
        "operands": [
          "label"
        ],
        "template": [
          "bgez $zero, ${label}"
        ]
      }
    ]
  },
  "beqz": {
    "description": "等于零时跳转（Branch if Equal Zero）",
    "forms": [
      {
        "operands": [
          "$rs",
          "label"
        ],
        "template": [
          "beq ${rs}, $zero, ${label}"
        ]
      }
    ]
  },
  "bnez": {
    "description": "不等于零时跳转（Branch if Not Equal Zero）",
    "forms": [
      {
        "operands": [
          "$rs",
          "label"
        ],
        "template": [
          "bne ${rs}, $zero, ${label}"
        ]
      }
    ]
  },
  "not": {
    "description": "按位取反（Bitwise NOT）",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs"
        ],
        "template": [
          "nor ${rd}, ${rs}, $zero"
        ]
      }
    ]
  },
  "neg": {
    "description": "有符号取负（Negate）",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs"
        ],
        "template": [
          "sub ${rd}, $zero, ${rs}"
        ]
      }
    ]
  },
  "negu": {
    "description": "无符号取负（Negate Unsigned）",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs"
        ],
        "template": [
          "subu ${rd}, $zero, ${rs}"
        ]
      }
    ]
  },
  "abs": {
    "description": "取绝对值（Absolute Value）",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs"
        ],
        "template": [
          "sra $at, ${rs}, 31",
          "xor ${rd}, $at, ${rs}",
          "subu ${rd}, ${rd}, $at"
        ]
      }
    ]
  },
  "add": {
    "description": "加法（ADDition）：第三操作数为立即数时展开",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs",
          "imm16_signed"
        ],
        "template": [
          "addi ${rd}, ${rs}, ${imm:signed16}"
        ]
      },
      {
        "operands": [
          "$rd",
          "$rs",
          "imm32"
        ],
        "template": [
          "lui $at, ${imm:upper16}",
          "ori $at, $at, ${imm:lower16}",
          "add ${rd}, ${rs}, $at"
        ]
      }
    ]
  },
  "addu": {
    "description": "无溢出加法（ADDition Unsigned）：第三操作数为立即数时展开",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs",
          "imm32"
        ],
        "template": [
          "lui $at, ${imm:upper16}",
          "ori $at, $at, ${imm:lower16}",
          "addu ${rd}, ${rs}, $at"
        ]
      }
    ]
  },
  "sub": {
    "description": "减法（SUBtraction）：第三操作数为立即数时展开",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs",
          "imm16_signed"
        ],
        "template": [
          "addi $at, $zero, ${imm:signed16}",
          "sub ${rd}, ${rs}, $at"
        ]
      },
      {
        "operands": [
          "$rd",
          "$rs",
          "imm32"
        ],
        "template": [
          "lui $at, ${imm:upper16}",
          "ori $at, $at, ${imm:lower16}",
          "sub ${rd}, ${rs}, $at"
        ]
      }
    ]
  },
  "subu": {
    "description": "无溢出减法（SUBtraction Unsigned）：第三操作数为立即数时展开",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs",
          "imm32"
        ],
        "template": [
          "lui $at, ${imm:upper16}",
          "ori $at, $at, ${imm:lower16}",
          "subu ${rd}, ${rs}, $at"
        ]
      }
    ]
  },
  "addi": {
    "description": "加法立即数（ADD Immediate）：立即数超出有符号16位范围时展开",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs",
          "imm32"
        ],
        "template": [
          "lui $at, ${imm:upper16}",
          "ori $at, $at, ${imm:lower16}",
          "add ${rd}, ${rs}, $at"
        ]
      }
    ]
  },
  "addiu": {
    "description": "无溢出加法立即数（ADD Immediate Unsigned）：立即数超出有符号16位范围时展开",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs",
          "imm32"
        ],
        "template": [
          "lui $at, ${imm:upper16}",
          "ori $at, $at, ${imm:lower16}",
          "addu ${rd}, ${rs}, $at"
        ]
      }
    ]
  },
  "subi": {
    "description": "减法立即数（SUBtract Immediate）：第三操作数为立即数时展开",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs",
          "imm16_signed"
        ],
        "template": [
          "addi $at, $zero, ${imm:signed16}",
          "sub ${rd}, ${rs}, $at"
        ]
      },
      {
        "operands": [
          "$rd",
          "$rs",
          "imm32"
        ],
        "template": [
          "lui $at, ${imm:upper16}",
          "ori $at, $at, ${imm:lower16}",
          "sub ${rd}, ${rs}, $at"
        ]
      }
    ]
  },
  "subiu": {
    "description": "无溢出减法立即数（SUBtract Immediate Unsigned）：第三操作数为立即数时展开",
    "forms": [
      {
        "operands": [
          "$rd",
          "$rs",
          "imm32"
        ],
        "template": [
          "lui $at, ${imm:upper16}",
          "ori $at, $at, ${imm:lower16}",
          "subu ${rd}, ${rs}, $at"
        ]
      }
    ]
  },
  "andi": {
    "description": "按位与立即数（AND Immediate）：立即数不在无符号16位范围时展开",
    "forms": [
      {
        "operands": [
          "$rd",
          "imm16_unsigned"
        ],
        "template": [
          "andi ${rd}, ${rd}, ${imm:hex16}"
        ]
      },
      {
        "operands": [
          "$rd",
          "imm32"
        ],
        "template": [
          "lui $at, ${imm:upper16}",
          "ori $at, $at, ${imm:lower16}",
          "and ${rd}, ${rd}, $at"
        ]
      },
      {
        "operands": [
          "$rd",
          "$rs",
          "imm32"
        ],
        "template": [
          "lui $at, ${imm:upper16}",
          "ori $at, $at, ${imm:lower16}",
          "and ${rd}, ${rs}, $at"
        ]
      }
    ]
  },
  "ori": {
    "description": "按位或立即数（OR Immediate）：立即数不在无符号16位范围时展开",
