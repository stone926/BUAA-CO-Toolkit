          "ori $at, $at, ${imm:lower16}",
          "div ${rs}, $at",
          "mfhi ${rd}"
        ]
      }
    ]
  },
  "remu": {
    "description": "无符号取余（REMainder Unsigned）：三操作数形式，取余数存入 $rd",
    "forms": [
      {
        "operands": [
          "$rd",
