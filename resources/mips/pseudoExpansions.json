          "divu ${rs}, $at",
          "mfhi ${rd}"
        ]
      }
    ]
  },
  "beq": {
    "description": "相等时跳转（Branch if EQual）：第二操作数为立即数时展开",
    "forms": [
      {
        "operands": [
          "$rs",
          "imm16_signed",
          "label"
        ],
        "template": [
          "addi $at, $zero, ${imm:signed16}",
          "beq $at, ${rs}, ${label}"
        ]
      },
      {
        "operands": [
