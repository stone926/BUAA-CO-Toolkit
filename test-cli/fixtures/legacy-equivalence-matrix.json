  "controlContracts": [
    {
      "id": "cancellation",
      "comparison": "not-comparable",
      "baselineSurface": "The fixed pre-provider runMarsFile signature has no AbortSignal input.",
      "currentSurface": "LegacyMarsProvider accepts ProviderRunContext.signal.",
      "reason": "Inventing cancellation on the historical lane would not execute the fixed baseline API.",
      "requiredIndependentGate": "phase1-process-supervisor-cancel"
    },
    {
      "id": "wall-clock-timeout",
      "comparison": "not-comparable",
      "baselineSurface": "The fixed pre-provider path reads a workspace timeout and exposes only timedOut on RunResult.",
      "currentSurface": "LegacyMarsProvider propagates provider-neutral timeout/stop status from the process supervisor.",
      "reason": "A wall-clock race between two separate JVMs is not deterministic equivalence evidence; timeout semantics require the dedicated process-supervisor gate.",
      "requiredIndependentGate": "phase1-process-supervisor-timeout"
    }
  ]
