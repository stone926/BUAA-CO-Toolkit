{
  "MIPS top P4/P5": {
    "prefix": "mips_top_p4",
    "body": [
      "module mips(",
      "    input clk,",
      "    input reset",
      ");",
      "",
      "endmodule"
    ],
    "description": "BUAA CO P4/P5 top module"
  },
  "MIPS top P6": {
    "prefix": "mips_top_p6",
    "body": [
      "module mips(",
      "    input clk,",
      "    input reset,",
      "    input [31:0] i_inst_rdata,",
      "    input [31:0] m_data_rdata,",
      "    output [31:0] i_inst_addr,",
      "    output [31:0] m_data_addr,",
      "    output [31:0] m_data_wdata,",
      "    output [3:0] m_data_byteen,",
      "    output [31:0] m_inst_addr,",
      "    output w_grf_we,",
      "    output [4:0] w_grf_addr,",
      "    output [31:0] w_grf_wdata,",
      "    output [31:0] w_inst_addr",
      ");",
      "",
      "endmodule"
    ],
    "description": "BUAA CO P6 top module interface"
  },
  "MIPS top P7": {
    "prefix": "mips_top_p7",
    "body": [
      "module mips(",
      "    input clk,",
      "    input reset,",
      "    input interrupt,",
      "    output [31:0] macroscopic_pc,",
      "    output [31:0] i_inst_addr,",
      "    input [31:0] i_inst_rdata,",
      "    output [31:0] m_data_addr,",
      "    input [31:0] m_data_rdata,",
      "    output [31:0] m_data_wdata,",
      "    output [3:0] m_data_byteen,",
      "    output [31:0] m_int_addr,",
      "    output [3:0] m_int_byteen,",
      "    output [31:0] m_inst_addr,",
      "    output w_grf_we,",
      "    output [4:0] w_grf_addr,",
      "    output [31:0] w_grf_wdata,",
      "    output [31:0] w_inst_addr",
      ");",
      "",
      "endmodule"
    ],
    "description": "BUAA CO P7 top module interface"
  },
  "Named module instance": {
    "prefix": "inst_named",
    "body": [
      "${1:module_name} ${2:u_module_name} (",
      "    .${3:port}(${4:signal})",
      ");"
    ],
    "description": "Named Verilog module instance"
  },
  "Begin block": {
    "prefix": "begin",
    "body": [
      "begin",
      "    ${0}",
      "end"
    ],
    "description": "Verilog begin/end block"
  },
  "Generate for": {
    "prefix": "generate_for",
    "body": [
      "genvar ${1:i};",
      "generate",
      "    for (${1:i} = 0; ${1:i} < ${2:WIDTH}; ${1:i} = ${1:i} + 1) begin : ${3:gen_loop}",
      "        ${0}",
      "    end",
      "endgenerate"
    ],
    "description": "Course-style named generate-for block"
  },
  "Pipeline register": {
    "prefix": "pipe_reg",
    "body": [
      "always @(posedge ${1:clk}) begin",
      "    if (${2:reset}) begin",
      "        ${3:stage_reg} <= ${4:0};",
      "    end else if (${5:enable}) begin",
      "        ${3:stage_reg} <= ${6:next_value};",
      "    end",
      "end"
    ],
    "description": "Clocked pipeline register with reset and enable"
  },
  "Clock reset testbench": {
    "prefix": "tb_clk_reset",
    "body": [
      "`timescale 1ns / 1ps",
      "",
      "module ${1:mips_tb};",
      "    reg clk;",
      "    reg reset;",
      "",
      "    ${2:mips} uut (",
      "        .clk(clk),",
      "        .reset(reset)",
      "    );",
      "",
      "    initial begin",
      "        clk = 1'b0;",
      "        forever #5 clk = ~clk;",
      "    end",
      "",
      "    initial begin",
      "        reset = 1'b1;",
      "        #20;",
      "        reset = 1'b0;",
      "        #200000;",
      "        \\$finish;",
      "    end",
      "endmodule"
    ],
    "description": "Clock/reset testbench skeleton"
  },
  "GRF display P5": {
    "prefix": "display_grf_p5",
    "body": "\\$display(\"%d@%h: \\$%d <= %h\", \\$time, ${1:WPC}, ${2:Waddr}, ${3:WData});",
    "description": "BUAA CO P5 GRF write display"
  },
  "DM display P5": {
    "prefix": "display_dm_p5",
    "body": "\\$display(\"%d@%h: *%h <= %h\", \\$time, ${1:pc}, ${2:addr}, ${3:din});",
    "description": "BUAA CO P5 DM write display"
  }
}
