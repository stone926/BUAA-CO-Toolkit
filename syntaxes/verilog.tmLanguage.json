{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Verilog",
  "scopeName": "source.verilog",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#compilerDirectives"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#systemTasks"
    },
    {
      "include": "#keywords"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.verilog",
          "match": "//.*$"
        },
        {
          "name": "comment.block.verilog",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.verilog",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.verilog",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "compilerDirectives": {
      "patterns": [
        {
          "name": "keyword.control.directive.verilog",
          "match": "`(?:define|undef|ifdef|ifndef|elsif|else|endif|include|timescale|default_nettype)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.verilog",
          "match": "\\b\\d+'[sS]?[bBoOdDhH][0-9a-fA-F_xXzZ?]+\\b|\\b\\d+\\b"
        }
      ]
    },
    "systemTasks": {
      "patterns": [
        {
          "name": "support.function.system-task.verilog",
          "match": "\\$(?:display|write|monitor|finish|stop|readmemh|readmemb|dumpfile|dumpvars|time|signed|unsigned|clog2|random|fopen|fclose|fdisplay|fwrite|fflush|fsdbDumpfile|fsdbDumpvars)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.verilog",
          "match": "\\b(?:always|automatic|and|assign|begin|buf|bufif0|bufif1|case|casex|casez|cell|cmos|config|deassign|default|defparam|design|disable|edge|else|end|endcase|endconfig|endfunction|endgenerate|endmodule|endprimitive|endspecify|endtable|endtask|event|for|force|forever|fork|function|generate|genvar|highz0|highz1|if|ifdef|ifndef|ifnone|incdir|include|initial|inout|input|instance|integer|join|large|liblist|library|localparam|macromodule|medium|module|nand|negedge|nmos|nor|noshowcancelled|not|notif0|notif1|or|output|parameter|pmos|posedge|primitive|pull0|pull1|pulldown|pullup|pulsestyle_onevent|pulsestyle_ondetect|rcmos|real|realtime|reg|release|repeat|rnmos|rpmos|rtran|rtranif0|rtranif1|scalared|showcancelled|signed|small|specify|specparam|strong0|strong1|supply0|supply1|table|task|time|tran|tranif0|tranif1|tri|tri0|tri1|triand|trior|trireg|unsigned|use|vectored|wait|wand|weak0|weak1|while|wire|wor|xnor|xor|logic)\\b"
        }
      ]
    }
  }
}
