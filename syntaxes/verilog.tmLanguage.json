{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Verilog",
  "scopeName": "source.verilog",
  "fileTypes": [
    "v",
    "vh"
  ],
  "x-generated-from": [
    "resources/verilog/keywords.json"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#formatCalls"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#directiveDefinitions"
    },
    {
      "include": "#directiveConditions"
    },
