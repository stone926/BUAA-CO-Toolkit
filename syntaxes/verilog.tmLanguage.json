    {
      "include": "#namedBlocks"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.verilog",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.verilog"
            }
          },
          "end": "$"
        },
        {
          "name": "comment.block.verilog",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.verilog"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.verilog"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.verilog",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.verilog"
            }
          },
          "end": "(?<!\\\\)(?:\\\\\\\\)*\\K\"|(?<!\\\\)(?=(?:\\\\\\\\)*\\n)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.verilog"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.verilog",
              "match": "\\\\(?:x[0-9A-Fa-f]+|[0-7]{1,3}|[^\\r\\n])"
            }
          ]
        }
      ]
    },
    "formatStrings": {
      "patterns": [
        {
          "name": "string.quoted.double.verilog",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.verilog"
            }
          },
          "end": "(?<!\\\\)(?:\\\\\\\\)*\\K\"|(?<!\\\\)(?=(?:\\\\\\\\)*\\n)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.verilog"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.verilog",
              "match": "\\\\(?:x[0-9A-Fa-f]+|[0-7]{1,3}|[^\\r\\n])"
            },
            {
              "name": "constant.other.placeholder.verilog",
              "match": "%[-+0# ]*[0-9]*(?:\\.[0-9]+)?[bBcCdDeEfFgGhHoOsStTmMuUvVzZxX%]"
            }
          ]
        }
      ]
    },
    "formatCalls": {
      "patterns": [
        {
          "name": "meta.function-call.format.verilog",
          "begin": "(\\$(?:fdisplay|display|monitor|fwrite|write)(?![A-Za-z0-9_$]))([\\t ]*)(\\()",
          "beginCaptures": {
            "1": {
              "name": "support.function.system-task.verilog"
            },
            "3": {
              "name": "punctuation.section.group.begin.verilog"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.group.end.verilog"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#formatStrings"
            },
            {
              "include": "#formatCallParentheses"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#knownSystemTasks"
            },
            {
              "include": "#genericSystemTasks"
            },
            {
              "include": "#escapedIdentifiers"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    },
    "formatCallParentheses": {
      "name": "meta.group.verilog",
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.group.begin.verilog"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.group.end.verilog"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#formatStrings"
        },
        {
          "include": "#formatCallParentheses"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#knownSystemTasks"
        },
        {
          "include": "#genericSystemTasks"
        },
        {
          "include": "#escapedIdentifiers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "directiveDefinitions": {
      "patterns": [
        {
          "name": "meta.preprocessor.define.verilog",
          "match": "^([\\t ]*)(`)(define)[\\t ]+([A-Za-z_][A-Za-z0-9_$]*)(?![A-Za-z0-9_$])",
          "captures": {
            "2": {
              "name": "punctuation.definition.directive.verilog"
            },
            "3": {
              "name": "keyword.control.directive.verilog"
            },
            "4": {
              "name": "entity.name.function.preprocessor.verilog"
            }
          }
        }
      ]
    },
    "directiveConditions": {
      "patterns": [
        {
          "name": "meta.preprocessor.condition.verilog",
          "match": "^([\\t ]*)(`)(ifdef|ifndef|elsif)[\\t ]+([A-Za-z_][A-Za-z0-9_$]*)(?![A-Za-z0-9_$])",
          "captures": {
            "2": {
              "name": "punctuation.definition.directive.verilog"
            },
            "3": {
              "name": "keyword.control.directive.verilog"
            },
            "4": {
              "name": "variable.other.preprocessor.verilog"
            }
          }
        }
      ]
    },
    "directiveMacroReferences": {
      "patterns": [
        {
          "name": "meta.preprocessor.macro-reference.verilog",
          "match": "^([\\t ]*)(`)(undef)[\\t ]+([A-Za-z_][A-Za-z0-9_$]*)(?![A-Za-z0-9_$])",
          "captures": {
            "2": {
              "name": "punctuation.definition.directive.verilog"
            },
            "3": {
              "name": "keyword.control.directive.verilog"
            },
            "4": {
              "name": "entity.name.function.preprocessor.verilog"
            }
          }
        }
      ]
    },
    "compilerDirectives": {
      "patterns": [
        {
          "match": "(`)(nounconnected_drive|unconnected_drive|default_nettype|begin_keywords|endcelldefine|end_keywords|undefineall|celldefine|timescale|resetall|include|define|ifndef|pragma|elsif|endif|ifdef|undef|else|line)(?![A-Za-z0-9_$])",
          "captures": {
            "1": {
              "name": "punctuation.definition.directive.verilog"
            },
            "2": {
              "name": "keyword.control.directive.verilog"
            }
          }
        }
      ]
    },
    "userMacros": {
      "patterns": [
        {
          "match": "(`)([A-Za-z_][A-Za-z0-9_$]*)(?![A-Za-z0-9_$])",
          "captures": {
            "1": {
              "name": "punctuation.definition.directive.verilog"
            },
            "2": {
              "name": "entity.name.function.preprocessor.verilog"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.verilog",
          "match": "(?<![A-Za-z0-9_$])(?:[0-9][0-9_]*)?'[sS]?[bB][01xXzZ?_]+(?![A-Za-z0-9_$])"
        },
        {
          "name": "constant.numeric.verilog",
          "match": "(?<![A-Za-z0-9_$])(?:[0-9][0-9_]*)?'[sS]?[oO][0-7xXzZ?_]+(?![A-Za-z0-9_$])"
        },
        {
          "name": "constant.numeric.verilog",
          "match": "(?<![A-Za-z0-9_$])(?:[0-9][0-9_]*)?'[sS]?[dD][0-9xXzZ?_]+(?![A-Za-z0-9_$])"
        },
        {
          "name": "constant.numeric.verilog",
          "match": "(?<![A-Za-z0-9_$])(?:[0-9][0-9_]*)?'[sS]?[hH][0-9a-fA-FxXzZ?_]+(?![A-Za-z0-9_$])"
        },
        {
          "name": "constant.numeric.verilog",
          "match": "(?<![A-Za-z0-9_$])'[01xXzZ](?![A-Za-z0-9_$])"
        },
        {
          "name": "constant.numeric.verilog",
          "match": "(?<![A-Za-z0-9_$])(?:(?:[0-9][0-9_]*\\.[0-9_]*|\\.[0-9][0-9_]*)(?:[eE][-+]?[0-9][0-9_]*)?|[0-9][0-9_]*[eE][-+]?[0-9][0-9_]*)(?![A-Za-z0-9_$])"
        },
        {
          "name": "constant.numeric.verilog",
          "match": "(?<![A-Za-z0-9_$])[0-9][0-9_]*(?![A-Za-z0-9_$])"
        }
      ]
    },
    "knownSystemTasks": {
      "patterns": [
        {
          "name": "support.function.system-task.verilog",
          "match": "\\$(?:fsdbDumpfile|fsdbDumpvars|fsdbDumpoff|fsdbDumpon|monitoroff|monitoron|dumpfile|dumpvars|fdisplay|readmemb|readmemh|unsigned|display|monitor|fclose|fflush|finish|fwrite|random|signed|clog2|fopen|write|stop|time)(?![A-Za-z0-9_$])"
        }
      ]
    },
    "genericSystemTasks": {
      "patterns": [
        {
          "name": "support.function.system-task.verilog",
          "match": "\\$[A-Za-z_][A-Za-z0-9_$]*(?![A-Za-z0-9_$])"
        }
      ]
    },
    "escapedIdentifiers": {
      "patterns": [
        {
          "name": "variable.other.identifier.escaped.verilog",
          "match": "\\\\[^\\s]+"
        }
      ]
    },
    "namedBlocks": {
      "patterns": [
        {
          "name": "meta.block.named.verilog",
          "match": "(?<![A-Za-z0-9_$])(begin|fork)(?![A-Za-z0-9_$])([\\t ]*)(:)([\\t ]*)([A-Za-z_][A-Za-z0-9_$]*|\\\\[^\\s]+)",
          "captures": {
            "1": {
              "name": "keyword.control.verilog"
            },
            "3": {
              "name": "punctuation.separator.label.verilog"
            },
            "5": {
              "name": "entity.name.label.verilog"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.verilog",
          "match": "(?<![A-Za-z0-9_$])(?:deassign|default|disable|endcase|forever|initial|negedge|posedge|release|always|assign|ifnone|repeat|begin|casex|casez|force|while|case|edge|else|fork|join|wait|end|for|if)(?![A-Za-z0-9_$])"
        },
        {
          "name": "keyword.declaration.verilog",
          "match": "(?<![A-Za-z0-9_$])(?:endprimitive|endfunction|endgenerate|macromodule|endspecify|localparam|endmodule|parameter|primitive|specparam|endtable|function|generate|endtask|specify|genvar|module|output|inout|input|table|task)(?![A-Za-z0-9_$])"
        },
        {
          "name": "storage.type.verilog",
          "match": "(?<![A-Za-z0-9_$])(?:realtime|integer|supply0|supply1|triand|trireg|event|logic|trior|real|time|tri0|tri1|wand|wire|reg|tri|wor)(?![A-Za-z0-9_$])"
        },
        {
          "name": "storage.modifier.verilog",
          "match": "(?<![A-Za-z0-9_$])(?:automatic|scalared|unsigned|vectored|signed)(?![A-Za-z0-9_$])"
        },
        {
          "name": "support.function.primitive.verilog",
          "match": "(?<![A-Za-z0-9_$])(?:pulldown|rtranif0|rtranif1|tranif0|tranif1|bufif0|bufif1|notif0|notif1|pullup|rcmos|rnmos|rpmos|rtran|cmos|nand|nmos|pmos|tran|xnor|and|buf|nor|not|xor|or)(?![A-Za-z0-9_$])"
        },
        {
          "name": "constant.language.strength.verilog",
          "match": "(?<![A-Za-z0-9_$])(?:strong0|strong1|highz0|highz1|medium|large|pull0|pull1|small|weak0|weak1)(?![A-Za-z0-9_$])"
        },
        {
          "name": "keyword.other.configuration.verilog",
          "match": "(?<![A-Za-z0-9_$])(?:pulsestyle_ondetect|pulsestyle_onevent|noshowcancelled|showcancelled|endconfig|instance|include|liblist|library|config|design|incdir|cell|use)(?![A-Za-z0-9_$])"
        },
        {
          "name": "keyword.other.unsupported.verilog",
          "match": "(?<![A-Za-z0-9_$])(?:defparam)(?![A-Za-z0-9_$])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.verilog",
          "match": "<<<=|>>>=|!==|<<<|<<=|===|>>=|>>>|-:|-=|->|!=|\\*\\*|\\*=|\\*>|/=|&&|&=|%=|\\^=|\\^~|\\+:|\\+=|<<|<=|==|=>|>=|>>|\\|=|\\|\\||~&|~\\^|~\\||-|:|!|\\?|\\*|/|&|%|\\^|\\+|<|=|>|\\||~"
        },
        {
          "name": "keyword.operator.event.verilog",
          "match": "[@#]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.group.verilog",
          "match": "[(){}\\[\\]]"
        },
        {
          "name": "punctuation.separator.verilog",
          "match": "[,;.]"
        },
        {
          "name": "punctuation.definition.verilog",
          "match": "['`]"
        }
      ]
    }
  }
}
