{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MIPS ASM",
  "scopeName": "source.mips",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#macroDefinitions"
    },
    {
      "include": "#eqvDefinitions"
    },
    {
      "include": "#macroParameters"
    },
    {
      "include": "#macroCalls"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#registers"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#instructions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.mips",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mips",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mips",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "macroDefinitions": {
      "patterns": [
        {
          "name": "meta.macro.definition.mips",
          "match": "^\\s*(\\.macro)\\s+([A-Za-z_.$][\\w.$]*)",
          "captures": {
            "1": {
              "name": "keyword.directive.macro.mips"
            },
            "2": {
              "name": "entity.name.function.macro.mips"
            }
          }
        }
      ]
    },
    "eqvDefinitions": {
      "patterns": [
        {
          "name": "meta.eqv.definition.mips",
          "match": "^\\s*(\\.eqv)\\s+([A-Za-z_.$][\\w.$]*)",
          "captures": {
            "1": {
              "name": "keyword.directive.eqv.mips"
            },
            "2": {
              "name": "variable.other.constant.eqv.mips"
            }
          }
        }
      ]
    },
    "macroParameters": {
      "patterns": [
        {
          "name": "variable.parameter.macro.mips",
          "match": "%[A-Za-z_.$][\\w.$]*\\b"
        }
      ]
    },
    "macroCalls": {
      "patterns": [
        {
          "name": "entity.name.function.macro-call.mips",
          "match": "\\b[A-Za-z_.$][\\w.$]*(?=\\s*\\()"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.directive.mips",
          "match": "\\B\\.(?:data|text|ktext|kdata|word|half|byte|float|double|space|ascii|asciiz|align|globl|extern|eqv|macro|end_macro|include)\\b"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.mips",
          "match": "^\\s*([A-Za-z_.$][\\w.$]*)(:)",
          "captures": {
            "1": {
              "name": "entity.name.label.mips"
            },
            "2": {
              "name": "punctuation.separator.label.mips"
            }
          }
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.mips",
          "match": "\\$(?:zero|at|v[01]|a[0-3]|t[0-9]|s[0-8]|k[01]|gp|sp|fp|ra|[0-9]|[12][0-9]|3[01])\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.mips",
          "match": "[-+]?0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.binary.mips",
          "match": "[-+]?0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.mips",
          "match": "[-+]?0[0-7]+\\b"
        },
        {
          "name": "constant.numeric.decimal.mips",
          "match": "[-+]?\\b\\d+\\b"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "keyword.control.instruction.mips",
          "match": "\\b(?i:abs|add|addi|addiu|addu|and|andi|b|beq|beqz|bge|bgeu|bgez|bgezal|bgt|bgtu|bgtz|ble|bleu|blez|blt|bltu|bltz|bltzal|bne|bnez|break|clo|clz|div|divu|eret|j|jal|jalr|jr|la|lb|lbu|lh|lhu|li|lui|lw|lwl|lwr|madd|maddu|mfc0|mfhi|mflo|move|movn|movz|msub|msubu|mtc0|mthi|mtlo|mul|mult|multu|neg|negu|nop|nor|not|or|ori|rem|remu|sb|seq|sge|sgeu|sgt|sgtu|sh|sle|sleu|sll|sllv|slt|slti|sltiu|sltu|sne|sra|srav|srl|srlv|sub|subi|subiu|subu|sw|swl|swr|syscall|xor|xori)\\b"
        }
      ]
    }
  }
}
